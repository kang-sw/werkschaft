{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Werkschaft",
  "version": "0.1.0",
  "identifier": "dev.werkschaft.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [{
        "identifier": "no-native-authority",
        "description": "Bundled pages and the dashboard use native menus",
        "local": false,
        "windows": ["main"],
        "permissions": []
      }, {
        "identifier": "title-strip",
        "description": "The Windows title strip page: window controls and native menu popups",
        "local": true,
        "webviews": ["main-strip"],
        "permissions": [
          "allow-strip-popup",
          "allow-strip-minimize",
          "allow-strip-toggle-maximize",
          "allow-strip-close",
          "allow-strip-drag"
        ]
      }],
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
