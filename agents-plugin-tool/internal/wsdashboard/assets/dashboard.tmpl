{{/* toolsum and toolbatches draw a ToolSummary: the lead's finished tool calls between two conversation entries (a tools ring entry), or so far in the open stretch (convlive). */}}
{{define "toolsum"}}{{$est := estContextText .InBytes .OutBytes}}<span class="row-icon">{{if .Failed}}{{icon "x"}}{{else}}{{icon "check"}}{{end}}</span><span class="row-content tsum"><span class="tsl">{{range $i, $t := .Tools}}{{if $i}} · {{end}}<span title="{{$t.Name}}">{{toolName $t.Name}}</span> {{$t.Calls}}{{end}}{{with .OtherCalls}}{{if $.Tools}} · {{t "tools.rest" .}}{{else}}{{t "tools.calls" .}}{{end}}{{end}}</span>{{if or .Failed .Usage $est}}<span class="tsn">{{with .Failed}}<b class="tf">{{t "count.failed" .}}</b>{{end}}{{with .Usage}}{{if $.Failed}} · {{end}}<span class="ttok" title="{{tokenTitle (requests $) .}}">{{tokenText (requests $) .}}</span>{{end}}{{if $est}}{{if or $.Failed $.Usage}} · {{end}}<span class="ttok" title="{{estContextTitle $.InBytes $.OutBytes}}">{{$est}}</span>{{end}}</span>{{end}}</span><span class="row-time">{{with .DurationMs}}{{template "span" .}}{{end}}</span><span class="row-chevron">{{icon "chev"}}</span>{{end}}
{{define "toolbatches"}}<ol class="brows">{{range .Batches}}{{$args := batchArgs .}}{{$list := argsList .}}<li class="brow {{if .Failed}}fail{{else}}done{{end}}"><span class="mk">{{if .Failed}}✗{{else}}✓{{end}}</span><span class="bp{{if $args}} one{{end}}"{{with $list}} title="{{.}}"{{end}}>{{if .Tools}}{{range .Tools}}<span class="tool"{{if not $list}} title="{{.Name}}"{{end}}>{{toolName .Name}}{{if gt .Calls 1}}<b class="x">×{{.Calls}}</b>{{end}}</span>{{end}}{{else}}{{range .Names}}<span class="tool"{{if not $list}} title="{{.}}"{{end}}>{{toolName .}}</span>{{end}}{{end}}{{with $args}}<span class="ba" title="{{.}}">{{.}}</span>{{end}}</span><span class="bm">{{range batchNums .}}{{.Sep}}<span{{with .Class}} class="{{.}}"{{end}} title="{{.Title}}">{{.Text}}</span>{{end}}</span></li>{{end}}{{with .BatchesOmitted}}<li class="brow more"><span class="mk"></span><span class="bp">{{t "tools.more" .}}</span><span class="bm"></span></li>{{end}}</ol>{{end}}
{{define "auditcallrow"}}<li><details class="au-call-details"{{if .ID}} data-key="call-{{.ID}}"{{end}}><summary class="conv-row au-row{{if .Failed}} au-fail{{else}} au-done{{end}}{{if .IsSummary}} au-static{{end}}"{{if .ID}} data-call="{{.ID}}"{{end}}><span class="row-icon au-mk">{{if .Failed}}{{icon "x"}}{{else}}{{icon "check"}}{{end}}</span><span class="row-content trace-content"><span class="au-tool" title="{{.Name}}">{{.ShortName}}</span>{{with .ArgsPreview}} <span class="au-args au-pv" title="{{.}}">{{.}}</span>{{end}}</span><span class="row-time au-right"><span class="au-att" hidden></span><span class="au-dur"{{if .DurationMs}} title="{{.DurationTitle}}"{{end}}>{{.Duration}}</span><span class="au-tok"{{with .TokTitle}} title="{{.}}"{{end}}>{{.TokText}}</span></span><span class="row-chevron">{{icon "chev"}}</span></summary>{{with .ArgsPreview}}<pre class="au-call-input">{{.}}</pre>{{end}}{{if .ID}}{{end}}<div class="conv-audit-items"></div><button type="button" class="au-open-call" data-call="{{.ID}}" title="{{.Name}}" aria-label="{{.Name}}"><svg class="i" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4"/><path d="m10 10 4 4"/></svg><span>{{t "js.audit.window.title"}}</span><span class="au-open-call-meta">· {{t "js.audit.tab.in"}} · {{t "js.audit.tab.out"}} · {{t "js.audit.tab.raw"}}</span></button></details></li>{{end}}
{{define "audittools"}}<div class="au-tools"{{if .Entry}} data-entry="{{.Entry}}" data-key="tools-{{.Entry}}"{{else}} data-key="tools-live"{{end}}{{with .AtUTC}} data-at="{{.}}"{{end}}><ol class="au-calls">{{range auditCallRows .Tools}}{{template "auditcallrow" .}}{{end}}</ol></div>{{end}}
{{/* turnsummary renders the shared collapsed turn tool summary row and expandable drawer (Decision 1, 2, 3, 5). */}}
{{define "turnauditcallrow"}}<li><details class="au-call-details"{{if .ID}} data-key="call-{{.ID}}"{{end}}><summary class="conv-row au-row{{if .Failed}} au-fail{{else}} au-done{{end}}{{if .IsSummary}} au-static{{end}}"{{if .ID}} data-call="{{.ID}}"{{end}}><span class="row-icon au-mk"><span class="d-turn-cat" data-cat="{{.Category}}" aria-hidden="true"></span></span><span class="row-content trace-content"><span class="au-tool" title="{{.Name}}">{{.ShortName}}</span>{{with .ArgsPreview}} <span class="au-args au-pv" title="{{.}}">{{.}}</span>{{end}}</span><span class="row-time au-right"><span class="au-att" hidden></span><span class="au-dur"{{if .DurationMs}} title="{{.DurationTitle}}"{{end}}>{{.Duration}}</span><span class="au-tok"{{with .TokTitle}} title="{{.}}"{{end}}>{{.TokText}}</span></span><span class="row-chevron">{{icon "chev"}}</span></summary>{{with .ArgsPreview}}<pre class="au-call-input">{{.}}</pre>{{end}}<div class="conv-audit-items"></div><button type="button" class="au-open-call" data-call="{{.ID}}" title="{{.Name}}" aria-label="{{.Name}}"><svg class="i" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4"/><path d="m10 10 4 4"/></svg><span>{{t "js.audit.window.title"}}</span><span class="au-open-call-meta">· {{t "js.audit.tab.in"}} · {{t "js.audit.tab.out"}} · {{t "js.audit.tab.raw"}}</span></button></details></li>{{end}}
{{define "turntoolbatches"}}<ol class="brows">{{range .Batches}}{{$args := batchArgs .}}{{$list := argsList .}}<li class="brow {{if .Failed}}fail{{else}}done{{end}}"><span class="mk"><span class="d-turn-cat" data-cat="{{turnBatchCategory .}}" aria-hidden="true"></span></span><span class="bp{{if $args}} one{{end}}"{{with $list}} title="{{.}}"{{end}}>{{if .Tools}}{{range .Tools}}<span class="tool"{{if not $list}} title="{{.Name}}"{{end}}>{{toolName .Name}}{{if gt .Calls 1}}<b class="x">×{{.Calls}}</b>{{end}}</span>{{end}}{{else}}{{range .Names}}<span class="tool"{{if not $list}} title="{{.}}"{{end}}>{{toolName .}}</span>{{end}}{{end}}{{with $args}}<span class="ba" title="{{.}}">{{.}}</span>{{end}}</span><span class="bm">{{range turnBatchNums .}}{{.Sep}}<span{{with .Class}} class="{{.}}"{{end}} title="{{.Title}}">{{.Text}}</span>{{end}}</span></li>{{end}}{{with .BatchesOmitted}}<li class="brow more"><span class="mk"></span><span class="bp">{{t "tools.more" .}}</span><span class="bm"></span></li>{{end}}</ol>{{end}}
{{define "turnmailitem"}}{{if eq .Kind "wake"}}<details class="mail-notification turn-trigger" data-key="wake-{{.Key}}"{{if .BoardNudgeSummary}} data-board-nudge="1"{{end}}{{with .BoardNudgeState}} data-mail-wake="{{.}}"{{end}}><summary class="conv-row"><span class="row-icon">{{icon "mail"}}</span><span class="row-content">{{with .BoardNudgeSummary}}<b>{{.}}</b>{{else}}<b>{{t "entry.mail.notification"}}</b><span class="src">{{t "entry.mail.unmatched"}}</span>{{end}}</span><span class="row-time au-right">{{template "clock" .At}}<span class="au-tok"{{with .MailTokTitle}} title="{{.}}"{{end}}>{{.MailTokText}}</span></span><span class="row-chevron">{{icon "chev"}}</span></summary><div class="row-details"><pre class="wake-body">{{.WakeText}}{{if .Truncated}} …{{end}}</pre></div></details>{{else if or .PeerLead .MatchedMailWake}}<article class="mail-block"{{if .MatchedMailWake}} data-mail-wake="matched"{{end}}><details class="mailline turn-trigger {{.Direction}}" data-key="mail-{{.Key}}"><summary class="conv-row">{{template "mailhead" .}}</summary><div class="row-details"><div class="mbody">{{.MailBody}}</div><pre class="wake-body mail-delivery">{{.MailDeliveryText}}</pre></div></details></article>{{else if .HasBody}}<details class="mailline turn-trigger {{.Direction}}" data-key="mail-{{.Key}}"><summary class="conv-row">{{template "mailhead" .}}</summary><div class="mbody">{{.Body}}</div></details>{{else}}<div class="mailline turn-trigger {{.Direction}} nobody"><div class="conv-row">{{template "mailhead" .}}</div></div>{{end}}{{end}}
{{define "turnsummary"}}{{$tok := .TokenText}}<details class="toolsline d-turn{{if .Live}} live d-turn-live{{end}}{{if .Failed}} d-turn-has-fail{{end}}" data-conv-turn="1"{{if .EntryKey}} data-entry="{{.EntryKey}}"{{end}} data-key="{{.Key}}"{{with .TurnKey}} data-turn-key="{{.}}"{{end}} data-turn-rev="{{.TurnRev}}" data-turn-calls="{{.Calls}}" data-turn-mails="{{.MailCount}}" data-turn-tok="{{.TokenValue}}"{{if .TokenEstimated}} data-turn-tok-est="1"{{end}}{{if gt .At 0}} data-turn-ts="{{.At}}"{{end}}{{with .AtRFC}} data-at="{{.}}"{{end}}{{with .TurnAtRFC}} data-turn-at="{{.}}"{{end}}{{if .Failed}} data-turn-failed="{{.Failed}}"{{end}}{{if .WakeTurn}} data-wake-turn="1"{{end}}{{if .Plain}} data-conv-turn-plain="1" hidden{{end}}{{with .Replies}} data-replies="{{.}}"{{end}}><summary class="conv-row d-turn-sum" data-conv-turn-summary aria-expanded="false"><span class="row-icon d-turn-ico" aria-hidden="true">{{if .Failed}}{{icon "x"}}{{else if .Live}}<span class="spin"></span>{{else}}{{icon "check"}}{{end}}</span><span class="row-content d-turn-main"><span class="d-turn-head">{{if .WakeTurn}}<span class="d-turn-wake" title="{{t "conv.turn.wake"}}">↳</span>{{else}}{{with .Origin}}{{template "origin" .}}{{end}}{{end}}<span class="d-turn-count" data-conv-turn-count>{{.CountText}}</span><span class="d-turn-meta">{{if and (gt .Calls 0) (gt .MailCount 0)}}<span class="d-turn-dot" aria-hidden="true">·</span><span class="d-turn-mails" data-conv-turn-mails>{{.MailCountText}}</span>{{end}}<span class="d-turn-folded" data-conv-turn-folded hidden><span class="d-turn-dot" aria-hidden="true">·</span>{{t "conv.turn.folded"}}</span>{{if and .Live (gt .StartMs 0)}}<span class="d-turn-dot" aria-hidden="true">·</span><time class="t d-turn-dur" data-ms="{{.StartMs}}" data-f="since">{{clock .StartMs}}</time>{{else if gt .DurationMs 0}}<span class="d-turn-dot" aria-hidden="true">·</span><span class="d-turn-dur" data-span="{{.DurationMs}}">{{batchSpanText .DurationMs}}</span>{{end}}<span class="d-turn-fails" data-conv-turn-fails{{if eq .Failed 0}} hidden{{end}}><span class="d-turn-dot" aria-hidden="true">·</span><b>{{t "conv.turn.failed" .Failed}}</b></span>{{with .Reason}}<span class="d-turn-dot" aria-hidden="true">·</span><span class="d-turn-reason">{{.}}</span>{{end}}<span class="turn-audit-counts"></span></span></span>{{if $tok}}<span class="d-turn-dot" aria-hidden="true">·</span><span class="d-turn-tok{{if .TokenEstimated}} d-turn-est{{end}}"{{if and (not .TokenEstimated) (gt .AddedTokens 0)}} data-tokens="{{.AddedTokens}}"{{end}} data-conv-turn-tokens{{if .TokenEstimated}} data-estimated="1"{{end}}{{with .TokenTitle}} title="{{.}}"{{end}}>{{$tok}}</span>{{end}}</span><span class="row-time">{{if gt .At 0}}{{template "clock" .At}}{{end}}</span><span class="row-chevron" aria-hidden="true">{{icon "chev"}}</span></summary><div class="d-turn-drawer" data-conv-turn-drawer>{{range .Gaps}}{{if .Tools}}{{$gap := .Tools}}<div class="d-turn-gap">{{if toolsHasCallIDs $gap}}<ol class="au-calls">{{range auditCallRows $gap}}{{template "turnauditcallrow" .}}{{end}}</ol>{{else}}{{template "turntoolbatches" $gap}}{{end}}{{with $gap.Usage}}<div class="d-turn-gap-meta"><span class="ttok" title="{{tokenTitle (requests $gap) .}}">{{tokenText (requests $gap) .}}</span></div>{{end}}</div>{{else if .Mail}}<div class="d-turn-gap d-turn-mail-gap">{{template "turnmailitem" .Mail}}</div>{{end}}{{end}}</div>{{if .Completed}}<div class="conv-audit-items"></div>{{end}}</details>{{end}}
{{define "peermailentry"}}<article class="mail-block" data-entry="{{.Key}}"{{if .SystemMail}} data-mail-system="1" data-mail-ts="{{.At}}"{{end}}{{if .MatchedMailWake}} data-mail-wake="matched"{{end}}{{with .AtRFC}} data-at="{{.}}"{{end}}><details class="mailline turn-trigger {{.Direction}}" data-key="mail-{{.Key}}"><summary class="conv-row">{{template "mailhead" .}}</summary><div class="row-details"><div class="mbody">{{.MailBody}}</div><pre class="wake-body mail-delivery">{{.MailDeliveryText}}</pre></div></details></article>{{end}}
{{define "agenthead"}}<span class="row-icon"><span class="arr">←</span>{{icon "robot"}}</span><span class="row-content"><span class="mpeer">{{or .Source .Cause}}</span>{{with .AgentBadge}}<span class="src">{{.}}</span>{{end}}<span class="mfirst">{{.AgentPreview}}</span></span><span class="row-time">{{template "clock" .At}}</span><span class="row-chevron">{{icon "chev"}}</span>{{end}}
