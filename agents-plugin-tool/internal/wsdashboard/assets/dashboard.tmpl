{{define "session"}}<!DOCTYPE html>
<html data-mode="{{.Mode}}" data-rid="{{.ReplyID}}"{{if .HasBoard}} data-board-incarnation="{{.BoardIncarnation}}"{{end}}{{with .Worktree}} data-worktree="{{.}}"{{end}} data-assets="{{.Assets.ID}}" data-wb-titlehost data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .SysOpen}} data-sysopen="1" data-can-control="1"{{end}}{{if .Hosted}} data-hosted="1"{{end}}{{if .IsChild}} data-child="1"{{end}}{{if .CanEditSettings}} data-can-edit-settings="1"{{end}}{{if .HandedOff}} data-handed="1"{{end}}{{with .Terminal}} data-term="{{.}}"{{end}}{{if .Frame}} data-frame="1"{{end}}{{if .Compact}} data-compact="1"{{end}}>
