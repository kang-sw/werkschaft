<button type="button" id="convo-bottom-btn" class="d-convo-bottom" aria-label="{{t "js.convo.jump.bottom"}}" title="{{t "js.convo.jump.bottom"}}" aria-hidden="true" tabindex="-1"><svg class="d-convo-bottom-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10"/><path d="M4 9l4 4 4-4"/></svg></button>
