<style>{{.Assets.XtermCSS}}</style>{{end}}
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.TrackerCSS}}</style>{{end}}</head>
<body class="dash {{.Mode}}{{if .Worktree}} live{{end}}"{{if or (eq .Mode "live") (eq .Mode "history")}} data-split-grid{{end}}>{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}{{.Assets.LucideSprite}}<div class="dwrap">
<div class="top">{{template "railbtn"}}{{region . "head"}}{{template "sse"}}{{template "tcen"}}{{template "qsslot"}}</div>
{{template "drawer" .}}
{{template "workpanel" .}}
