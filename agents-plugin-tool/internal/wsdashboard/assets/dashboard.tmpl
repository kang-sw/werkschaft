{{define "srow"}}<a class="sess{{if not .Live}} ended{{end}}" href="/s/{{.ReplyID}}" data-rid="{{.ReplyID}}"{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}><span class="who"><span class="rid{{if .Label}} lbl{{end}}"{{if .Label}} title="{{.ReplyID}}"{{end}}>{{or .Label .ReplyID}}</span><span class="sub">{{if .Tool}}<span class="tn">{{.Tool}}</span>{{end}}{{with .RunningAgents}}<span class="agents-mini">{{t "srow.agents" .}}</span>{{end}}{{if not .HasBoard}}<span class="agents-mini">{{t "srow.noboard"}}</span>{{end}}</span></span><span class="hostc">{{with .Harness}}<span class="host">{{.}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}</span>{{if eq .Lifecycle "pending_deletion"}}<span class="phase none">{{t "head.ended"}}</span>{{else if .Exit}}{{template "hostexit" .Exit}}{{else if eq .Lifecycle "stopped"}}<span class="phase none">{{t "head.stopped"}}</span>{{else if .Adapter}}{{template "phase" .Phase}}{{else}}<span class="phase none" title="{{t "srow.nolive.title"}}">{{t "srow.nolive"}}</span>{{end}}<span class="qs">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}</span><span class="when">{{template "ago" .LastSeen}}</span></a>{{end}}

{{/* The session rail (pageview_rail.go): every session page's left card,
one shared render without the viewed session (the page marks its own row,
.cur, on the client). The daemon orders the rows and workspaces by the rail
layout (rail_layout.go) and renders each row's star from it; the list
carries the layout's generation (data-lgen) and, while the layout holds no
entry, data-layout-empty, which has a browser import its retired local
order. A workspace is a
repository, its sessions under its worktrees (data-g, the worktree's path),
or a plain folder; each row is two lines, the star outside the row's link,
and an ended row a daemon can bring back carries the revive entry
(data-revive, its move) after the link, shown disabled with its reason when
the move is blocked. A parent row's live children follow it in its children
box (.rkids, data-parent): one line each, the message in the row's title,
no star, their own group in data-g and a branch tag when it is not the
parent's; the parent carries the toggle and its children's roll-ups
(.kap, .kidorb), which show while the page collapses it (kcol), and a
stored parent data-kids. A workspace bar is a container,
not a button: its collapse toggle (.wstog), the add-worktree + (a repository
on a daemon that keeps stored workspaces), and forget (a stored workspace)
are sibling buttons. Every worktree heading (.wthd), admitted, pending or
rejected, is a focusable link (tabindex, role) that opens the worktree page
on click and on Enter (dashboard-rail.js openWorktree). */}}
{{define "r-rail"}}<div class="rail-session-panel"><div class="rhd"><b class="rtitle">{{t "rail.title"}}</b>{{if .CanAdd}}<button type="button" class="radd" data-add="ws" title="{{t "rail.ws.add"}}" aria-label="{{t "rail.ws.add"}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}<span class="rsp"></span><span class="chip" title="{{t "rail.live.title"}}">{{t "index.live" .Live}}</span>{{with .CountApproval}}<span class="chip perm" title="{{t "rail.approvals"}}">{{icon "lock"}}{{.}}</span>{{end}}{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{if .CanSpawn}}<button type="button" class="rref rsleep" id="railsleep"{{if not .CountSleep}} disabled{{end}} title="{{if .CountSleep}}{{t "rail.sleep"}}{{else}}{{t "rail.sleep.none"}}{{end}}" aria-label="{{if .CountSleep}}{{t "rail.sleep"}}{{else}}{{t "rail.sleep.none"}}{{end}}" aria-haspopup="dialog">{{icon "moon"}}</button>{{end}}<button type="button" class="rref" id="railref" title="{{t "rail.refresh"}}" aria-label="{{t "rail.refresh"}}">{{icon "reload"}}</button></div><div class="rlist" id="rlist" data-max="{{.LabelMax}}" data-lgen="{{.LayoutGen}}"{{if .LayoutEmpty}} data-layout-empty="1"{{end}}>{{range $ws := .Workspaces}}<section class="rws" data-ws="{{.Path}}"><div class="wsbar"><button type="button" class="wstog" aria-expanded="true" title="{{.Path}}">{{if .Repo}}<span class="wsi" title="{{t "rail.repo"}}">{{icon "repo"}}</span>{{else}}<span class="wsi" title="{{t "rail.folder"}}">{{icon "wsfolder"}}</span>{{end}}<span class="nm">{{.Name}}</span><span class="pp">{{.Path}}</span></button>{{if and .Repo $.CanAdd}}<button type="button" class="radd" data-add="wt" title="{{t "rail.wt.add" .Name}}" aria-label="{{t "rail.wt.add" .Name}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}{{if and (not .Repo) $.CanAdd}}<button type="button" class="rgit" title="{{t "rail.gitinit"}}" aria-label="{{t "rail.gitinit"}}" aria-haspopup="dialog" aria-expanded="false">{{icon "gitinit"}}</button>{{end}}{{if .Stored}}<button type="button" class="rforget" title="{{t "rail.ws.forget" .Name}}" aria-label="{{t "rail.ws.forget" .Name}}">{{icon "x"}}</button>{{end}}{{with .Approvals}}<span class="chip perm" title="{{t "rail.approvals"}}">{{icon "lock"}}{{.}}</span>{{end}}{{template "r-config-gear" (settingsgear "project" .SettingsID "")}}<button type="button" class="memo-count" title="Workspace memos" aria-label="Workspace memos">▤ <span>{{.MemoCount}}</span></button><span class="ct" title="{{t "rail.live.title"}}">{{.Live}}</span></div><div class="wsbody">{{if .Repo}}{{with .PendingWorktrees}}<div class="rpend"><div class="pendhd"><span class="pdot"></span>{{t "rail.admission.pending"}} <span class="pn">{{len .}}</span><span class="phint">{{t "rail.admission.pending.hint"}}</span></div>{{range .}}{{template "r-pending-worktree" .}}{{end}}</div>{{end}}{{range .AdmittedWorktrees}}<div class="rwt{{if .Empty}} empty{{end}}" data-g="{{.Path}}"><div class="wthd" tabindex="0" role="link" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else}}{{.Branch}}{{end}}</span>{{if .Root}}<span class="wtroot" role="img" title="{{t "rail.root"}}" aria-label="{{t "rail.root"}}">{{icon "repo"}}</span>{{end}}<span class="wf">· {{if .Root}}{{t "rail.root"}}{{else}}{{.Folder}}{{end}}</span>{{if $.CanSpawn}}{{$b := .Branch}}{{if .Detached}}{{$b = t "rail.detached"}}{{end}}<button type="button" class="rnew" data-root="{{.Path}}" data-name="{{$ws.Name}}" data-branch="{{$b}}" title="{{t "rail.new.title" $b}}" aria-label="{{t "rail.new.title" $b}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}{{if and .Deletable $.CanAdd}}<button type="button" class="rdel" data-ws="{{$ws.Path}}" data-path="{{.Path}}" data-folder="{{.Folder}}" title="{{t "rail.wt.delete" .Folder}}" aria-label="{{t "rail.wt.delete" .Folder}}" aria-haspopup="dialog">{{icon "trash"}}</button>{{end}}{{template "r-config-gear" (settingsgear "repo" .SettingsID .SettingsID)}}{{if .HasChanges}}<span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span>{{end}}</div>{{template "rsessions" .}}</div>{{end}}{{with .RejectedWorktrees}}<details class="rrej"><summary>{{icon "x"}}<span class="fl">{{t "rail.admission.rejected"}} <b class="d-n">{{len .}}</b></span>{{with $.RejectedPrompt}}<button type="button" class="rrej-copy" data-admission-copy-all data-copy="{{.}}" title="{{t "rail.admission.copyall"}}" aria-label="{{t "rail.admission.copyall"}}">{{icon "copy"}}</button>{{end}}</summary>{{range .}}<div class="rwt" data-g="{{.Path}}" data-admission="{{.Admission}}" data-repository="{{.AdmissionRepository}}" data-path="{{.AdmissionPath}}" data-revision="{{.Revision}}"><div class="wthd" tabindex="0" role="link" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else if .Branch}}{{.Branch}}{{else}}{{.Folder}}{{end}}</span><span class="wf">· {{.Folder}}</span><span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span><button type="button" class="admission-undo" title="{{t "rail.admission.undo.title"}}">{{icon "undo"}}{{t "rail.admission.undo"}}</button></div><div class="wtpath" title="{{.Path}}"><span class="d-pt">{{.ShortPath}}</span></div>{{template "rsessions" .}}</div>{{end}}</details>{{end}}{{else}}{{template "rsessions" .}}{{end}}</div></section>{{else}}<div class="rail-empty-guide"><span class="rail-empty-icon">{{icon "wsfolder"}}</span><b class="rail-empty-title">{{t "rail.ws.empty.title"}}</b><p class="rail-empty-sub">{{t "rail.ws.empty.sub"}}</p>{{if $.CanAdd}}<button type="button" class="rail-empty-add" data-add="ws">{{icon "plus"}}{{t "rail.ws.empty.add"}}</button>{{end}}{{with .PendingWorkspaces}}<div class="rail-empty-hint">{{t "rail.ws.empty.hint" (len .)}}</div>{{end}}</div>{{end}}</div>{{if or .CanAdd .PendingWorkspaces .RejectedWorkspaces}}{{template "r-workspace-admission" .}}{{end}}<div class="admission-feedback" role="group" aria-label="{{t "rail.admission.notice"}}" hidden><div class="afrow"><span class="admission-status" role="status" aria-live="polite"></span><button type="button" class="afx" data-admission-dismiss title="{{t "rail.admission.dismiss"}}" aria-label="{{t "rail.admission.dismiss"}}">{{icon "x"}}</button></div><div class="admission-corrections"></div><div class="admission-copy" hidden><button type="button" class="afcopy" data-admission-copy>{{icon "copy"}}{{t "rail.admission.retry"}}</button><details><summary>{{t "rail.admission.prompt"}}</summary><textarea readonly rows="6" aria-label="{{t "rail.admission.prompt"}}"></textarea></details></div></div><div class="rcap" hidden role="toolbar" aria-label="{{t "rail.admission.cap"}}"><button type="button" class="clr" data-admission-clear aria-label="{{t "rail.admission.clearall"}}" title="{{t "rail.admission.clearall"}}">{{icon "x"}}</button><span class="seg ok"></span><span class="seg no"></span><button type="button" class="go" data-admission-apply title="{{t "rail.admission.apply.title"}}">{{icon "check"}}{{t "rail.admission.apply"}}</button></div></div><div id="rail-companion-slot" class="rail-companion-slot" hidden></div>{{end}}

{{/* Rail footer for unframed standalone renders (Frame: false). Shell-framed
renders retire .rfoot and mount these global controls in #shell-bottom. */}}
{{define "rfoot"}}<div class="rfoot"><button type="button" class="btn gear settings-toggle" id="gear" title="{{t "gear.title"}}" aria-label="{{t "drawer.settings"}}" aria-haspopup="dialog" aria-controls="gmenu" aria-expanded="false">{{icon "gear"}}</button><button type="button" class="btn gear r-config-global" data-scope-entry="global" title="{{t "js.settings.rail.global"}}" aria-label="{{t "js.settings.title"}}">{{icon "gear"}}</button><button type="button" class="btn gear rail-home" title="{{t "rail.home"}}" aria-label="{{t "rail.home"}}"><svg class="i li" aria-hidden="true"><use href="#l-house"/></svg></button></div>{{end}}


{{define "r-workspace-admission"}}<details class="rws-unreg" data-key="rail-unregistered-workspaces"><summary class="unreg-sum"><svg class="i unreg-chev" aria-hidden="true"><use href="#l-chevron-right"/></svg><span class="unreg-dot{{if not .PendingWorkspaces}} zero{{end}}"></span><span class="unreg-lbl">{{t "rail.ws.unreg.title"}}</span><span class="unreg-draft-pill" hidden></span><span class="unreg-count">{{len .PendingWorkspaces}}</span></summary><div class="unreg-body"><div class="unreg-toolbar"><span class="unreg-pend-stat">{{t "rail.ws.unreg.pending"}} <span class="pn">{{len .PendingWorkspaces}}</span></span><button type="button" class="unreg-reject-all" id="unreg-reject-all" data-reject-label="{{t "rail.ws.unreg.rejectall"}}" data-clear-label="{{t "rail.ws.unreg.rejectall.clear"}}"{{if not .PendingWorkspaces}} disabled{{end}}>{{t "rail.ws.unreg.rejectall"}}</button></div>{{if gt (len .PendingWorkspaces) 10}}<div class="unreg-filter-wrap"><svg class="i" aria-hidden="true"><use href="#l-search"/></svg><input type="search" class="unreg-filter" id="unreg-filter" placeholder="{{t "rail.ws.unreg.filter" (len .PendingWorkspaces)}}" aria-label="{{t "rail.ws.unreg.filter" (len .PendingWorkspaces)}}"></div>{{end}}<div class="unreg-list" id="unreg-list">{{range .PendingWorkspaces}}<div class="rwt d-pend unreg-row" data-unreg-path="{{.Path}}"><div class="unreg-row-main"><span class="tgs"><button type="button" class="tg ap" data-ws-admission-action="approve" aria-pressed="false" aria-label="{{t "rail.ws.unreg.approve" .Name}}" title="{{t "rail.ws.unreg.approve.title"}}">{{icon "check"}}</button><button type="button" class="tg rj" data-ws-admission-action="reject" aria-pressed="false" aria-label="{{t "rail.ws.unreg.reject" .Name}}" title="{{t "rail.ws.unreg.reject.title"}}">{{icon "x"}}</button></span><div class="unreg-info" title="{{.Path}}"><div class="unreg-name">{{.Name}}</div><div class="unreg-parent">{{.ParentPath}}</div></div><button type="button" class="unreg-scount" data-tog-sess="{{.Path}}" aria-expanded="false" title="{{t "rail.ws.unreg.sessions.title" .SessionCount}}">{{.SessionCount}}</button></div><div class="unreg-sessions" hidden>{{range .AllSessions}}<a class="unreg-slink" href="/s/{{.ReplyID}}"><span class="hb sm" data-h="{{.Harness}}"></span><span class="unreg-stitle">{{or .Label .ReplyID}}</span>{{with .LastTool}}<time class="unreg-stime t" data-ms="{{.}}" data-f="rel">{{.}}</time>{{end}}</a>{{end}}</div></div>{{else}}<div class="unreg-empty-filter">{{t "rail.ws.unreg.empty"}}</div>{{end}}<div class="unreg-empty-filter unreg-filter-empty" hidden>{{t "rail.ws.unreg.filter.empty"}}</div></div>{{with .RejectedWorkspaces}}<details class="rrej" id="unreg-rrej" data-key="rail-unregistered-rejected"><summary>{{icon "x"}}<span class="fl">{{t "rail.ws.unreg.rejected"}} <b class="d-n">({{len .}})</b></span></summary><div class="rrej-list">{{range .}}<div class="rrej-row" data-ws-rej-path="{{.Path}}"><div class="rrej-row-info" title="{{.Path}}"><div class="rrej-row-name">{{.Name}}</div><div class="rrej-row-path">{{.ParentPath}}</div></div><button type="button" class="unreg-undo" data-ws-undo="{{.Path}}" title="{{t "rail.ws.unreg.undo.title"}}">{{icon "undo"}}{{t "rail.ws.unreg.undo"}}</button></div>{{end}}</div></details>{{end}}</div></details>{{if or .PendingWorkspaces .RejectedWorkspaces}}<div class="unreg-notif" hidden>{{range .PendingWorkspaces}}{{range .LiveSessions}}{{template "r-notif-row" .}}{{end}}{{end}}{{range .RejectedWorkspaces}}{{range .LiveSessions}}{{template "r-notif-row" .}}{{end}}{{end}}</div>{{end}}{{end}}

{{/* r-notif-row carries, for a live session under a pending or rejected
workspace, the attributes rrow gives the page's notification scan (.rs rows
and [data-ap]), inside a hidden box no pointer reaches: those workspaces
list their sessions as links only, and their waits, questions and finishes
still notify. */}}
{{define "r-notif-row"}}<div class="rs{{if not .InSessionList}} ended{{end}}{{if .Stopped}} stopped{{end}}" data-rid="{{.ReplyID}}" data-asks="{{.OpenAskIDs}}"{{if .Busy}} data-busy="1"{{end}}{{if .Active}} data-active="1"{{end}}{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}{{if .Child}} data-g="{{.Group}}"{{end}}>{{with .LastTool}}<time class="when t" data-ms="{{.}}"></time>{{end}}{{template "rmsg" .}}</div>{{end}}
{{define "r-pending-worktree"}}<div class="rwt d-pend" data-g="{{.Path}}" data-origin="{{.Origin}}" data-admission="{{.Admission}}" data-repository="{{.AdmissionRepository}}" data-path="{{.AdmissionPath}}" data-revision="{{.Revision}}"><div class="wthd" tabindex="0" role="link" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else}}{{.Branch}}{{end}}</span><span class="wf">· {{.Folder}}</span>{{if .HasChanges}}<span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span>{{end}}<span class="tgs"><button type="button" class="tg ap" data-admission-action="approve" aria-pressed="false" aria-label="{{t "rail.admission.approve"}}" title="{{t "rail.admission.approve.title"}}">{{icon "check"}}</button><button type="button" class="tg rj" data-admission-action="reject" aria-pressed="false" aria-label="{{t "rail.admission.reject"}}" title="{{t "rail.admission.reject.title"}}">{{icon "x"}}</button></span></div><div class="wtpath" title="{{.Path}}"><span class="d-pt">{{.ShortPath}}</span><span class="d-tag"></span></div><div class="admission-row-correction" hidden><span>{{t "rail.admission.stale"}}</span><button type="button" data-admission-clear-row>{{t "rail.admission.clear"}}</button><button type="button" data-admission-reselect>{{t "rail.admission.reselect"}}</button></div>{{template "rsessions" .}}</div>{{end}}

{{define "rsessions"}}{{if or .Sessions .Ended .Archived}}<div class="rsessions">{{range .Sessions}}{{$p := .ReplyID}}{{template "rrow" .}}{{with .Children}}<div class="rkids" data-parent="{{$p}}">{{range .}}{{template "rrow" .}}{{end}}</div>{{end}}{{end}}{{template "rfold" .}}</div>{{end}}{{end}}

{{/* The fold row under a group's live rows: two buttons, archived (left) and
ended (right), each opening a scrolling, searchable popup of its rows (the
page script, rpFoldMake). The .rended lists are that popup's hidden
source: the CSS never shows them, so a long history costs the live rows no
space. A button with no rows is disabled. */}}
{{define "rfold"}}<div class="rfold" role="group" aria-label="{{t "rail.fold"}}" data-key="{{.Path}}"{{if and (not .Archived) (not .Ended)}} data-empty="1"{{end}}><button type="button" class="rfh" data-k="arch" aria-haspopup="dialog" aria-expanded="false" title="{{t "rail.archived" (len .Archived)}}"{{if not .Archived}} disabled{{end}}>{{icon "archive"}}{{t "rail.fold.archived"}} <span class="d-n">{{len .Archived}}</span></button><button type="button" class="rfh" data-k="del" aria-haspopup="dialog" aria-expanded="false" title="{{t "rail.ended" (len .Ended)}}"{{if not .Ended}} disabled{{end}}>{{icon "clock"}}{{t "rail.fold.ended"}} <span class="d-n">{{len .Ended}}</span></button></div>{{with .Archived}}<div class="rended" data-k="arch"><div class="rsessions">{{range .}}{{template "rrow" .}}{{end}}</div></div>{{end}}{{with .Ended}}<div class="rended" data-k="del"><div class="rsessions">{{range .}}{{template "rrow" .}}{{end}}</div></div>{{end}}{{end}}

{{/* The harness icon's tooltip and label: the harness, then its state. */}}
{{define "hitip"}}{{with .Harness}}{{.}}{{else}}?{{end}} · {{if eq .Lifecycle "stopped"}}{{t "head.stopped"}}{{else if eq .Lifecycle "pending_deletion"}}{{t "head.ended"}}{{else if .Approval}}{{t "rail.approval"}}{{else if .Working}}{{t "rail.working"}}{{else if .BackgroundTasks}}{{t "agent.background"}}{{else if .Failure}}{{template "noticeword" .Failure.Kind}}{{else}}{{t "rail.waiting"}}{{end}}{{end}}

{{/* rmsg is a row's message link: the second line's text (a hosted exit,
the awaited tool, or the last message), or, on a parent with no message,
an empty link that keeps the rest of its meta line opening the session. A
child row has none. */}}
{{define "rmsg"}}<a class="drmsg" href="/s/{{.ReplyID}}" tabindex="-1">{{if .Child}}{{else if .Exit}}<span class="s2">{{template "hostexit" .Exit}}</span>{{else if and .Approval .Approval.Tool}}<span class="s2 ap"><b class="who">{{toolName .Approval.Tool}}</b>{{.Approval.Args}}</span>{{else}}{{with .Message}}<span class="s2">{{if $.User}}<b class="who">{{t "rail.you"}}</b>{{end}}{{.}}</span>{{end}}{{end}}</a>{{end}}

{{define "rrow"}}<div class="rs{{if not .InSessionList}} ended{{end}}{{if .Stopped}} stopped{{end}}{{if .Archived}} archived{{end}}{{if and .Hosted (or .Live .Archived)}} hosted-row{{end}}" data-rid="{{.ReplyID}}" data-asks="{{.OpenAskIDs}}"{{if .Busy}} data-busy="1"{{end}}{{if .Active}} data-active="1"{{end}}{{if not (or .StarHidden .Archived)}} data-star="{{if .Starred}}1{{else}}0{{end}}"{{end}}{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}{{if .HasChildren}} data-kids="1"{{end}}{{if .Child}} data-g="{{.Group}}"{{with .Message}} title="{{.}}"{{end}}{{end}}><span class="drgrip" aria-hidden="true"{{if or .InSessionList .Archived (and .Hosted (eq .Revive "reopen") (not .ReviveBlocked))}} data-drag="1"{{end}}{{if .Hosted}} data-host="1"{{end}}{{if .Starred}} data-star-was="1"{{end}}{{if .HasProcess}} data-proc="1"{{end}}{{if or .BackgroundTasks .OwnExecJobs}} data-bg="1"{{end}}{{with .Revive}} data-revive="{{.}}"{{end}}{{if .ReviveBlocked}} data-revive-blocked="{{.ReviveBlocked}}"{{end}}>{{icon "grip"}}</span><div class="drbody"><div class="s1"><a class="rl" href="/s/{{.ReplyID}}"><span class="hiw"><span class="hb{{if .Child}} sm{{end}}{{if .Approval}} perm{{else if .Working}}{{else if .Failure}} err{{end}}" data-h="{{.Harness}}" role="img" aria-label="{{template "hitip" .}}" title="{{template "hitip" .}}">{{if and .Working (not .Approval)}}<span class="hbr"></span>{{end}}{{if .KidWorking}}<span class="hbr kidorb"></span>{{end}}</span>{{with .CountPolicy}}<span class="qdot" role="img" aria-label="{{tn "rail.questions" .}}" title="{{tn "rail.questions" .}}"></span>{{end}}{{if and .Starred (not (or .StarHidden .Archived))}}<span class="hstar" role="img" aria-label="{{t "js.rail.starred"}}" title="{{t "js.rail.starred"}}">{{icon "pin"}}</span>{{end}}{{with .Subagents}}<span class="sbn" role="img" title="{{t "srow.agents" .}}" aria-label="{{t "srow.agents" .}}">{{icon "robot"}}</span>{{end}}</span><span class="rid{{if .Label}} lbl{{end}}">{{or .Label .ReplyID}}</span>{{if eq .Lifecycle "stopped"}}<span class="rstate">{{t "head.stopped"}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}{{with .BranchTag}}<span class="rbt" title="{{$.Group}}">{{icon "branch"}}<span>{{.}}</span></span>{{end}}</a><a class="drtail" href="/s/{{.ReplyID}}" tabindex="-1">{{with .Approval}}<span class="chip perm" title="{{if .Tool}}{{t "rail.approve.title" (toolName .Tool)}}{{else}}{{t "rail.approval"}}{{end}}">{{icon "lock"}}{{t "rail.approve"}}</span>{{end}}{{if and (not .Working) (not .Approval) .BackgroundTasks}}<span class="chip bgt" title="{{t "tree.bg.title"}}">{{t "agent.background"}}</span>{{end}}{{with .KidApprovals}}<span class="chip perm kap" title="{{tn "rail.kids.approval" .}}">?</span>{{end}}<span class="drslot">{{if .DeleteAt}}<time class="when del" data-ms="{{.DeleteAt}}" data-f="del" data-tl="{{t "rail.deleteat"}}">{{clock .DeleteAt}}</time>{{else if and .Archived .LastActive}}<time class="when t" data-ms="{{.LastActive}}" data-f="relago" data-tl="{{t "rail.lastactive"}}">{{clock .LastActive}}</time>{{else}}{{with .LastTool}}<time class="when t" data-ms="{{.}}" data-f="rel" data-tl="{{t "rail.lasttool"}}">{{clock .}}</time>{{end}}{{end}}</span></a>{{if and .Live (not .Archived)}}{{template "r-config-gear" (settingsgear "session" .ReplyID .SettingsWorktree)}}{{end}}<span class="dracts"><button type="button" class="drren" data-label="{{.Label}}" title="{{t "head.rename"}}" aria-label="{{t "head.rename"}}">{{icon "pencil"}}</button><button type="button" class="drcopy" data-copy="{{.MailboxRef}}" data-mailbox-open="{{.MailboxOpen}}" title="{{t "rail.copy"}}" aria-label="{{t "rail.copy"}}">{{icon "copy"}}</button>{{if and .Hosted .Live .HasProcess}}<button type="button" class="drstop{{if .SafeStop}} d-stop-safe{{else}} d-stop-unsafe{{end}}" data-safe="{{if .SafeStop}}1{{else}}0{{end}}" data-hold-mode="radial" title="{{if .SafeStop}}{{t "rail.stop.safe"}}{{else}}{{t "rail.stop.unsafe"}}{{end}}" aria-label="{{if .SafeStop}}{{t "rail.stop.safe"}}{{else}}{{t "rail.stop.unsafe"}}{{end}}">{{if .SafeStop}}{{icon "moon"}}{{else}}{{icon "stop"}}{{end}}</button>{{else if .Archived}}<button type="button" class="drarch unarch" data-act="unhide" title="{{t "rail.unarchive"}}" aria-label="{{t "rail.unarchive"}}">{{icon "archive-restore"}}</button>{{end}}</span></div>{{$msg := and (not .Child) (or .Exit (and .Approval .Approval.Tool) .Message)}}{{with .Children}}<div class="drmeta"><button type="button" class="kidtog" aria-expanded="true" title="{{tn "rail.kids" (len .)}}" aria-label="{{tn "rail.kids" (len .)}}">{{icon "chev"}}{{icon "person"}}<span class="kn">{{len .}}</span></button>{{with $.KidBusy}}<sub class="drkwork" title="{{tn "rail.kids.busy" .}}">{{.}}</sub>{{end}}{{template "rmsg" $}}</div>{{else}}{{if $msg}}{{template "rmsg" .}}{{end}}{{end}}</div>{{if .Revive}}<button type="button" class="rrev" data-revive="{{.Revive}}"{{if .ReviveBlocked}} aria-disabled="true" title="{{t "rail.revive.nosession"}}" aria-label="{{t "rail.revive.nosession"}}"{{else if eq .Revive "reopen"}} title="{{t "rail.reopen.title"}}"{{else}} title="{{t "rail.takeover.title"}}"{{end}}>{{if eq .Revive "reopen"}}{{t "rail.reopen"}}{{else}}{{t "rail.takeover"}}{{end}}</button>{{end}}{{template "session-hover" .}}</div>{{end}}

{{/* Hover sources are inert, escaped server markup. The shared rail script
copies only the hovered row's own source outside the SSE-replaced regions.
Only explicit response evidence establishes output identity or last-turn t/s. */}}
{{define "session-hover"}}<template class="shp-source"{{if .Hover.Stale}} data-stale="1"{{end}}><div class="shp-hd"><span class="hb" data-h="{{.Harness}}"></span><b class="shp-nm">{{or .Label .ReplyID}}</b>{{if eq .Lifecycle "pending_deletion"}}<span class="chip">{{t "head.ended"}}</span>{{else if eq .Lifecycle "stopped"}}<span class="chip">{{t "head.stopped"}}</span>{{else if .Stopped}}<span class="chip">{{if and .Exit (eq .Exit.Reason "idle_timeout")}}{{t "phase.idle"}} · {{end}}{{t "hostexit.stopped"}}</span>{{else}}{{template "tphase" .Hover.Phase}}{{end}}</div><div class="shp-sub"><span>{{.ReplyID}}</span><span>{{.Harness}}</span>{{with .BranchTag}}<span>{{.}}</span>{{end}}</div>{{template "observed-model" .Hover.Observed}}{{with .Hover}}{{if .Band.Context}}{{template "r-ctx" .}}{{else}}<div class="shp-unk">{{t "hover.context.unknown"}}</div>{{end}}{{end}}<div class="shp-stats"><div class="shp-stat">{{if .Hover.Rate}}<b class="tps">{{.Hover.Rate}}</b>{{else}}<b class="na">—</b>{{end}}<span>{{if .Working}}{{t "hover.rate"}}{{else}}{{t "hover.lastrate"}}{{end}}</span></div><div class="shp-stat"><b>{{if .Hover.TurnStartedAt}}{{template "dur" .Hover.TurnStartedAt}}{{else if .Hover.LastTurnMs}}{{template "span" .Hover.LastTurnMs}}{{else}}—{{end}}</b><span>{{if .Hover.TurnStartedAt}}{{t "hover.turn"}}{{else}}{{t "hover.lastturn"}}{{end}}</span></div><div class="shp-stat"><b>{{if and .Live (not .Hover.Stale)}}{{.Subagents}}{{else}}—{{end}}</b><span>{{t "hover.children"}}</span></div></div><div class="shp-foot">{{if and .Archived .LastActive}}<span>{{t "rail.lastactive"}} <time class="t" data-ms="{{.LastActive}}" data-f="relago">{{clock .LastActive}}</time></span>{{else}}{{with .LastTool}}<span>{{t "rail.lasttool"}} {{template "ago" .}}</span>{{end}}{{end}}{{with .Hover.Band.Cost}}<span>{{t "hover.cost"}} <b>{{.}}</b></span>{{end}}{{with .Hover.RegisteredAt}}<span>{{t "hover.registered"}} {{template "ago" .}}</span>{{end}}{{with .Hover.SnapshotAt}}<span>{{t "hover.snapshot"}} {{template "ago" .}}</span>{{end}}</div>{{if .Exit}}<div class="shp-note exit">{{template "hostexit" .Exit}}</div>{{end}}</template>{{end}}

{{define "agent-model-hover"}}<template class="shp-source"{{if not .IsRunning}} data-stale="1"{{end}}><div class="shp-hd"><b class="shp-nm">{{or .Label .ID}}</b>{{if .IsRunning}}{{template "tphase" .Phase}}{{else}}<span class="chip">{{template "aended" .EndedStatus}}</span>{{end}}</div><div class="shp-sub"><span>{{or .ReplyID .ID}}</span></div>{{template "observed-model" .Observed}}{{with .Model}}<div class="shp-last">{{t "hover.reported"}} · {{.}}{{if not $.Observed}} · {{t "hover.unverified"}}{{end}}</div>{{end}}{{with .Effort}}<div class="shp-last">{{t "hover.effort" .}}</div>{{end}}{{with .ContextText}}<div class="shp-last">{{t "agent.context" $.ContextTokens}} · {{.}}</div>{{end}}</template>{{end}}

{{/* Evidence time and source survive idle/stopped states. The popup shows only
its latest transition; the expanded session/agent detail owns full history. */}}
{{define "observed-model"}}<div class="shp-model"><div class="shp-mtx"><span class="shp-last">{{t "hover.observed"}}</span>{{if .}}<span class="shp-mid">{{.Current.Model}}</span><span class="shp-last">{{t "hover.lastobserved"}} · {{template "clock" .Current.At}} · {{.Current.Source}}</span>{{with .Current.Effort}}<span class="shp-last">{{t "hover.effort" .}} · {{$.Current.EffortSource}}</span>{{end}}{{with .Change}}<span class="shp-last">{{.Previous}} → {{.Model}} · {{template "clock" .At}}</span>{{end}}{{else}}<span class="shp-unk">{{t "hover.unknown"}}</span>{{end}}</div>{{if .}}{{with .Current.Effort}}<span class="shp-eff">{{.}}</span>{{end}}{{end}}</div>{{end}}

{{define "observed-history"}}{{if .}}{{range .History}}<li class="brow"><span class="bp">{{with .Previous}}{{.}} → {{end}}{{.Model}} · {{.Source}}</span><span class="bm">{{template "clock" .At}}</span></li>{{end}}{{end}}{{end}}

{{/* The file view's pages (file_route.go): a rendered markdown file, and the
"not viewable" page that offers the path copies only. Neither is a region;
both inline the board's stylesheet for its colours and markdown rules. */}}
{{define "filecss"}}.fileview .fwrap { max-width: 920px; margin: 0 auto; padding: 18px 20px 48px; }
.fileview .fhead { margin-bottom: 12px; }
.fileview code.fpath { font-size: 12.5px; color: var(--wb-muted-fg); overflow-wrap: anywhere; }
.fileview .fbody { background: var(--wb-card); border-radius: 10px; padding: 14px 18px; overflow-wrap: anywhere; }
.fileview .fbody h1, .fileview .fbody h2, .fileview .fbody h3, .fileview .fbody h4 { font-weight: 700; margin: 14px 0 6px; }
.fileview .fbody h1 { font-size: 1.5em; } .fileview .fbody h2 { font-size: 1.3em; } .fileview .fbody h3 { font-size: 1.15em; }
.fileview .fbody > :first-child { margin-top: 0; }
.fileview .fbody hr { border: 0; border-top: 1px solid var(--wb-muted); margin: 12px 0; }
.fileview .fnone { margin: 0 0 12px; }
.fileview .fcopy { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.fileview .fcopy button { font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 8px; border: 0; background: var(--wb-muted); color: var(--wb-fg); cursor: pointer; }
.fileview .fnote { font-size: 12.5px; color: var(--wb-muted-fg); }{{end}}

{{define "file-md"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{firstPaint}}
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div><article class="md fbody">{{.HTML}}</article></div></body></html>
{{end}}

{{define "file-none"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{firstPaint}}
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div>
<p class="fnone">{{t "file.none" .Reason}}</p>
<div class="fcopy"><button type="button" data-copy="{{.Rel}}">{{t "file.copyrel"}}</button><button type="button" data-copy="{{.Abs}}">{{t "file.copyabs"}}</button><span class="fnote" id="fnote" role="status" data-ok="{{t "file.copied"}}" data-fail="{{t "file.copyfail"}}"></span></div></div>
<script nonce="{{.Nonce}}">(function () {
  // A LAN page over plain http is not a secure context, where
  // navigator.clipboard is missing: copy through a selected textarea there.
  var doc = document, note = doc.getElementById("fnote");
  function done(ok) { note.textContent = note.getAttribute(ok ? "data-ok" : "data-fail"); }
  function fallback(text) {
    var t = doc.createElement("textarea");
    t.value = text;
    t.setAttribute("readonly", "");
    t.style.position = "fixed";
    t.style.opacity = "0";
    doc.body.appendChild(t);
    t.select();
    var ok = false;
    try { ok = doc.execCommand("copy"); } catch (e) { ok = false; }
    doc.body.removeChild(t);
    done(ok);
  }
  doc.addEventListener("click", function (e) {
    var b = e.target && e.target.closest && e.target.closest("[data-copy]");
    if (!b) return;
    var text = b.getAttribute("data-copy");
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { fallback(text); });
    else fallback(text);
  });
})();</script></body></html>
{{end}}

{{/* The re-mint page (fs_outside.go): what a tab on an outside HTML file
shows when its capability no longer verifies. Its script posts the mint for
the path the URL named and replaces the page with the fresh URL, at most
once in a few seconds per tab; a refused mint shows the note. */}}
{{define "file-remint"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{firstPaint}}
<title>{{.Abs}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview" data-mint="{{.Mint}}" data-base="{{.Base}}" data-abs="{{.Abs}}" data-rel="{{.Rel}}"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Abs}}</code></div>
<p class="fnone" id="fgone" hidden>{{t "file.outside.gone"}}</p></div>
<script nonce="{{.Nonce}}">(function () {
  var b = document.body, key = "ws.outside.remint", now = Date.now();
  function gone() { document.getElementById("fgone").hidden = false; }
  try {
    if (now - (+sessionStorage.getItem(key) || 0) < 5000) { gone(); return; }
    sessionStorage.setItem(key, String(now));
  } catch (e) {}
  if (!window.fetch) { gone(); return; }
  fetch(b.getAttribute("data-mint"), {
    method: "POST", credentials: "same-origin", cache: "no-store",
    headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: b.getAttribute("data-abs") })
  }).then(function (r) {
    if (!r.ok) throw r.status;
    return r.json();
  }).then(function (v) {
    var view = v && typeof v.view === "string" ? v.view : "";
    if (view.indexOf(b.getAttribute("data-base")) !== 0) { gone(); return; }
    location.replace(view.slice(0, view.lastIndexOf("/") + 1) + b.getAttribute("data-rel"));
  }).catch(gone);
})();</script></body></html>
{{end}}

{{define "r-config-gear"}}<button type="button" class="r-config-gear" data-scope-entry="{{.Scope}}" data-settings-target="{{.Target}}"{{with .Worktree}} data-settings-worktree="{{.}}"{{end}} title="{{if eq .Scope "project"}}{{t "js.settings.rail.project"}}{{else if eq .Scope "repo"}}{{t "js.settings.rail.repo"}}{{else}}{{t "js.settings.rail.session"}}{{end}}" aria-label="{{if eq .Scope "project"}}{{t "js.settings.rail.project"}}{{else if eq .Scope "repo"}}{{t "js.settings.rail.repo"}}{{else}}{{t "js.settings.rail.session"}}{{end}}">{{icon "gear"}}</button>{{end}}

{{define "config-settings"}}<!DOCTYPE html>
<html data-mode="settings" data-frame="1" data-lang="{{lang}}"{{with .Theme}} data-theme="{{.}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{firstPaint}}
<title>{{t "js.settings.title"}} · Werkschaft</title>
<link rel="stylesheet" href="/s/{{.Assets.FrameWhiteboardFile}}">
<link rel="stylesheet" href="/s/{{.Assets.FrameCSSFile}}">
<link rel="stylesheet" href="/s/{{.Assets.SettingsCSSFile}}">
<script defer src="/s/{{index .Assets.SettingsI18nFiles lang}}"></script>
<script defer src="/s/{{.Assets.SettingsScriptFile}}"></script></head>
<body class="dash live">{{.Assets.Sprite}}{{.Assets.LucideSprite}}<div class="dwrap">
<div class="top">{{template "railbtn"}}</div>
<div class="dbody">{{template "railph"}}
<main class="stage" data-settings-view{{if .HasAccount}} data-settings-account{{end}} aria-labelledby="settings-title">
<header class="shd">
<div class="shd-top"><div class="shd-title">{{icon "gear"}}<h1 id="settings-title">{{t "js.settings.title"}}</h1><span class="route-pill">/settings</span></div>
<div class="scope-target-pill" data-settings-target-display><span></span><code></code></div>
<button type="button" data-settings-close aria-label="{{t "js.card.close"}}">×</button></div>
</header>
<div class="sbody"><nav class="snav" data-settings-sections aria-label="{{t "js.settings.categories"}}"></nav>
<div class="smain">
<nav class="prec-strip" data-settings-precedence aria-label="{{t "js.settings.precedence"}}"></nav>
<div class="filter-bar">
<div class="search-wrap"><input class="search-input" type="search" data-settings-search placeholder="{{t "js.settings.search"}}" aria-label="{{t "js.settings.search"}}"></div>
<div class="fchips" data-settings-filters role="group" aria-label="{{t "js.settings.filters"}}"></div>
<span class="ov-counter" data-settings-count></span>
</div>
<section class="scontent" data-settings-content></section></div></div>
<div data-settings-proposal hidden></div>
</main></div></div></body></html>{{end}}
