} data-at="{{.}}"{{end}}><summary class="conv-row">{{template "agenthead" .}}</summary><div class="row-details">{{with .Text}}<pre class="wake-body">{{.}}{{if $.Truncated}} …{{end}}</pre>{{end}}</div><div class="conv-audit-items"></div></details>{{end}}{{end}}

