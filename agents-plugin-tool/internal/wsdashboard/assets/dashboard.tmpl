<div id="agisland" class="agisland" data-mode="idle" data-tool-label='{{t "phase.tool"}}' hidden><div id="agcompact" class="agview agcompact" role="button" tabindex="0" aria-label="{{t "hud.expand"}}" title="{{t "hud.expand"}}" aria-controls="agpop" aria-expanded="false"><div class="hud-tree-scroll"><div class="hud-canvas"><svg class="hud-lines" aria-hidden="true"></svg><div class="hud-roots"></div></div></div></div><div id="agidle" class="agview agidle" role="button" tabindex="0" aria-label="{{t "tree.agents"}}" aria-controls="agpop" aria-expanded="false">{{icon "agents"}}</div>{{template "agpop" .}}</div><div id="hud-tooltip" class="hud-tooltip" role="tooltip" hidden></div>
<div id="composer" class="composer"{{if and .Hosted (not .IsChild)}} data-cexec="1"{{end}}><div class="cbadges"><button type="button" class="ibadge" id="ibadge" title="{{t "js.interrupt.title"}}" hidden><span class="istop"></span><span class="ilabel">{{t "js.interrupt"}}</span></button>{{template "subbadge" .}}</div>{{region . "ctx"}}{{if .SysOpen}}{{region . "cmds"}}{{end}}<div class="cimgs" id="cimgs"></div><div class="cchips" id="cchips"></div><div class="crow"><span class="ccmd" id="ccmd" title="{{t "composer.cmd.title"}}" hidden><b class="ccmd-name"></b><span class="ccmd-args" hidden></span><button type="button" class="unchip" data-uncmd title="{{t "composer.cmd.remove"}}" aria-label="{{t "composer.cmd.remove"}}">×</button></span><div class="cfield"><div class="chl" id="chl" aria-hidden="true"></div><textarea id="ctext" rows="1" aria-description="{{t "composer.aria"}}" placeholder="{{t "js.hint.enter"}}"></textarea><div class="cvox-cap" id="cvox-cap" role="status" aria-live="polite" hidden></div></div><div class="csend-wrap" id="csend-wrap"><button type="button" class="csend" id="csend" title="{{t "composer.send"}}" aria-label="{{t "composer.send"}}">{{icon "send"}}<span class="csend-kbd" id="csend-kbd" aria-hidden="true" hidden></span></button><button type="button" class="csend-revert" id="csend-revert" title="{{t "js.composer.multiline.revert"}}" aria-label="{{t "js.composer.multiline.revert"}}" hidden>×</button></div></div><template id="heldacts">{{template "hsteer" ""}}{{template "hcancel" ""}}</template><div class="cfoot"{{if not (or .Hosted .IsChild)}} data-cfoot-empty="1" hidden{{end}}><span class="cvox-slot" id="cvox-slot" data-voice-slot="bottom-left" hidden><button type="button" class="cvox" id="cvox" title="{{t "js.voice.start"}}" aria-label="{{t "js.voice.start"}}" aria-pressed="false" hidden>{{icon "mic"}}<span class="cvox-badge" aria-hidden="true"></span></button></span>{{if or .Hosted .IsChild}}{{template "composerpills" .}}{{end}}{{region . "sline"}}{{if .WhiteboardCapable}}<button type="button" class="wbonly-btn" id="wbonly" aria-pressed="false" title="{{t "composer.wbonly.title"}}"><span class="wbonly-dot" aria-hidden="true"></span><span>{{t "composer.wbonly"}}</span></button>{{end}}</div></div>
{{else if .SavedConversation}}<nav id="tabbar" class="tabbar"><button data-tab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button data-tab="board" aria-pressed="false">{{icon "board"}}{{t "tab.board"}}<span class="tdot"></span></button></nav>
<div id="convo" class="convo" aria-label="{{t "tab.conversation"}}">{{region . "entries"}}</div>
{{end}}<div id="bcol" class="bcol">{{region . "board"}}</div>
</main></div></div>
{{if not .Frame}}{{template "settings" .}}{{end}}
{{if .Frame}}<script src="/s/{{index .Assets.FrameI18nFiles lang}}"></script>
<script src="/s/{{.Assets.FrameScriptFile}}"></script>{{if .Terminal}}
<script src="/s/{{.Assets.FrameTermFile}}"></script>{{end}}{{if and .SysOpen (not .Worktree)}}
<script src="/s/{{.Assets.FrameWebFile}}"></script>{{end}}
<script src="/s/{{.Assets.FrameSelectFile}}"></script>
<script src="/s/{{.Assets.FrameSourceMapFile}}"></script>
{{else}}<script>{{i18n}}</script>
<script>{{.Assets.ConfirmScript}}</script>
<script>{{.Assets.AnswersScript}}</script>
<script>window.wbForm = function () {
{{.Assets.FormScript}}};
window.wbMermaid = function () {
{{.Assets.MermaidInit}}};
window.wbMermaidFile = {{.Assets.MermaidFile}};</script>
<script>{{.Assets.ViewerScript}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.HoldConfirmScript}}</script>
<script>{{.Assets.TrackerScript}}</script>
<script>{{.Assets.MentionScript}}</script>
<script>{{.Assets.RailScript}}</script>
<script>{{.Assets.MemoScript}}</script>
<script>{{.Assets.UsageScript}}</script>
<script>{{.Assets.ShellScript}}</script>
<script>{{.Assets.CardsScript}}</script>
<script>{{.Assets.OverviewScript}}</script>
<script>{{.Assets.PreviewScript}}</script>
<script>{{.Assets.PanelScript}}</script>
<script>{{.Assets.FilesScript}}</script>{{if .Terminal}}
<script>{{.Assets.TerminalScript}}</script>{{end}}{{if and .SysOpen (not .Worktree)}}
<script>{{.Assets.WebScript}}</script>{{end}}
<script>{{.Assets.SelectAllScript}}</script>
<script>window.wsSourceMap = {{.Assets.ScriptSourceMap}};</script>{{end}}
{{if .Frame}}<script src="/s/{{.Assets.ScriptFile}}"></script>{{else}}<script>{{.Assets.Script}}</script>{{end}}
</body></html>
{{end}}

{{/* The iframe shell (shellPageData, shell.js): the session rail and the
top header, which stay across navigations, over the frames the dashboard's
pages load in (#frames, the first one the page asked for). Each frame's page
lays itself out as it stands alone, under placeholders for the rail and the
header's shell-owned items (railph, data-frame), and hands its head to the
shell. The rail takes its stored marks before it ever shows: rail.js loads
in the head, and the inline script right after the rail applies the marks
(rail.js marks) and lifts data-premark, which keeps the rail's rows unseen
until then. */}}
{{define "shell"}}<!DOCTYPE html>
<html data-mode="shell" data-shell="1" data-rid="{{.RID}}" data-assets="{{.Assets.ID}}" data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .SysOpen}} data-sysopen="1" data-can-control="1"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{firstPaint}}{{pwa .Theme}}
<title>{{.Title}}</title>
<style>{{.Assets.WhiteboardCSS}}</style>
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.CompanionCSS}}</style>
<style>{{.Assets.TrackerCSS}}</style>
<script>{{.Assets.RailScript}}</script></head>
<body class="dash live shell">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}{{.Assets.LucideSprite}}<div class="stage-well-bg" id="stage-well-bg" aria-hidden="true"></div><div class="frames" id="frames"><iframe class="sframe on" src="{{.Src}}" title="{{.Title}}"></iframe></div>
<div class="dwrap">
<div class="top{{if .OwnHead}} sh-own{{end}}"><div class="top-left" id="slot-top-left">{{template "railbtn"}}{{region . "head"}}{{template "sse"}}</div><div class="top-center" id="slot-top-center">{{template "shellqs"}}</div><div class="top-right" id="slot-top-right" aria-hidden="true"></div></div>
{{template "account-consent"}}
{{template "daemon-confirm"}}
<div class="dbody"><aside id="rail" class="rail" aria-label="{{t "rail.title"}}" data-premark>{{region . "rail"}}</aside><script>(function () {
  var R = window.WsRail, r = document.getElementById("r-rail"), s = null;
  try {
    try { s = window.localStorage; } catch (e) { s = null; }
    var store = { load: function (k) { try { return s ? s.getItem(k) : null; } catch (e) { return null; } }, save: function () {} };
    var rw = parseInt(store.load("ws.dashboard.railWidth"), 10);
    if (isFinite(rw)) {
      rw = Math.max(220, Math.min(360, Math.round(rw)));
      document.documentElement.style.setProperty("--rail-w", rw + "px");
    }
    if (store.load("ws.dashboard.railCollapsed") === "1") {
      document.documentElement.setAttribute("data-rail-collapsed", "true");
    }
    if (!R || !r) return;
    R.marks(r, R.state(store), document.documentElement.getAttribute("data-rid"));
    var list = document.getElementById("rlist"), top = parseInt(store.load("ws.dashboard.railscroll"), 10);
    if (list && isFinite(top)) list.scrollTop = top;
  } finally { document.getElementById("rail").removeAttribute("data-premark"); }
})();</script><div class="rscrim" id="rscrim"></div>
{{template "memopad"}}</div></div>
<div class="rail-splitter" id="rail-splitter" role="separator" aria-orientation="vertical" aria-label="Resize session rail" aria-valuemin="220" aria-valuemax="360" aria-valuenow="280" tabindex="0"></div>
<footer class="shell-bottom" id="shell-bottom" aria-label="Status bar"><div class="bot-left" id="slot-bot-left"><button type="button" class="bot-btn rail-home" title="{{t "rail.home"}}" aria-label="{{t "rail.home"}}"><svg class="i li" aria-hidden="true"><use href="#l-house"/></svg><span class="bot-lbl">{{t "rail.home"}}</span></button><button type="button" class="bot-btn r-config-global" data-scope-entry="global" title="{{t "js.settings.rail.global"}}" aria-label="{{t "js.settings.title"}}">{{icon "gear"}}<span class="bot-lbl">{{t "js.settings.title"}}</span></button><button type="button" class="bot-btn settings-toggle" id="gear" title="{{t "gear.title"}}" aria-label="{{t "drawer.settings"}}" aria-haspopup="dialog" aria-controls="gmenu" aria-expanded="false">{{icon "gear"}}<span class="bot-lbl">{{t "drawer.settings"}}</span></button></div><div class="bot-center" id="slot-bot-center"><span class="talert" id="talert" hidden></span></div><div class="bot-right" id="slot-bot-right"><button type="button" class="usage-toggle" aria-label="Plan usage" title="Plan usage" aria-haspopup="dialog" aria-expanded="false"><span class="usage-empty">Plan usage</span></button>{{if .Holders}}<button type="button" class="hd-trigger" id="holders-trigger" data-state="zero" aria-haspopup="dialog" aria-controls="holders-pop" aria-expanded="false" title="{{t "hd.title"}}" aria-label="{{t "hd.title"}}"><span class="hd-dot" aria-hidden="true"></span>{{icon "layers"}}<span class="hd-count" id="hd-count">0</span></button>{{end}}</div></footer>
{{template "settings" .}}
{{if .SysOpen}}<dialog id="workflow-settings" aria-label="{{t "js.settings.title"}}"></dialog>{{end}}
<script>{{i18n}}</script>
<script>{{.Assets.ConfirmScript}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.HoldConfirmScript}}</script>
<script>{{.Assets.MentionScript}}</script>
<script>{{.Assets.MemoScript}}</script>
<script>{{.Assets.UsageScript}}</script>
<script>window.wsCompanionConfig = {{.Companion}};
window.wsCompanionVrmRuntime = "/s/{{.Assets.CompanionVrmFile}}";</script>
<script>{{.Assets.CompanionScript}}</script>
<script>{{.Assets.ShellScript}}</script>{{if .SysOpen}}
<script>{{.Assets.CardsScript}}</script>
<script>{{.Assets.FilesScript}}</script>{{end}}
<script>{{.Assets.SelectAllScript}}</script>
<script>window.wsSourceMap = {{.Assets.ScriptSourceMap}};</script>
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{/* The rail button: it opens the session rail where the rail overlays
the page (narrow windows, beside the pinned column), and on a page the
iframe shell frames holds the place of the shell's own (data-frame). */}}
{{define "railbtn"}}<a class="back" id="railbtn" href="/" title="{{t "nav.sessions"}} (Ctrl+`)" aria-label="{{t "nav.sessions"}} (Ctrl+`)" aria-controls="rail" aria-expanded="false">{{icon "menu"}}</a>{{end}}

{{/* The rail's placeholder on a page the iframe shell frames: an empty,
invisible rail that takes the rail's place in every layout, under the
shell's own rail. */}}
{{define "railph"}}<aside class="rail rail-ph" aria-hidden="true"></aside>{{end}}

{{/* The workspace memo pad beside the rail (memo.js). */}}
{{define "memopad"}}<aside id="memo-pad" class="memo-pad" aria-label="Workspace memos" aria-hidden="true"><header><span class="memo-ic" aria-hidden="true">▤</span><b>Memos</b><span id="memo-workspace" class="memo-ws"></span><span id="memo-n" class="memo-n"></span><span class="memo-sp"></span><button type="button" id="memo-close" aria-label="Close memos">✕</button></header><div class="memo-add"><textarea id="memo-input" rows="1" maxlength="8000" aria-label="New memo" aria-description="Enter to save, Shift+Enter for a newline" placeholder="Add a memo…"></textarea><div class="memo-hint" aria-hidden="true"><span><kbd>Enter</kbd> save</span><span><kbd>Shift</kbd>+<kbd>Enter</kbd> newline</span></div></div><p id="memo-status" role="status"></p><div id="memo-list" class="memo-list"></div><div id="memo-undo" hidden><span>Memo deleted.</span><button type="button">Undo</button></div></aside>{{end}}

{{/* The search-palette button slot. Its modal mounts in the body, outside
header stacking contexts (dashboard.js mounts the tracker renderer). */}}
{{define "qsslot"}}<span class="qsslot" id="qsslot"></span>{{end}}
{{define "shellqs"}}<span class="qsslot" id="qsslot" data-shell-qs="1"><button type="button" class="tkqs-btn" id="tkqs" title="{{t "js.tk.qs.tip"}} (Ctrl+K)" aria-label="{{t "js.tk.qs.tip"}}" aria-controls="tkqpop" aria-expanded="false"><svg class="i li" aria-hidden="true"><use href="#l-search"/></svg><span class="tkqs-ph">{{t "js.tk.qs.tip"}}</span><kbd class="tkqs-kbd" id="tkqs-kbd">Ctrl+K</kbd></button></span>{{end}}

{{/* The header's center cluster, shell-owned and outside every region: the
plan usage handle (usage.js draws it; it steps down to one compact trigger
first when the header runs short, rail.js topFit) and the global alert slot
beside it, empty and hidden until a cross-session alert fills it. */}}
{{define "tcen"}}<span class="tcen"><button type="button" class="usage-toggle" aria-label="Plan usage" title="Plan usage" aria-haspopup="dialog" aria-expanded="false"><span class="usage-empty">Plan usage</span></button><span class="talert" id="talert" hidden></span></span>{{end}}

{{/* The stream indicator: a bare dot the page script turns off while the
stream is down. A session page whose head has a harness badge lights the
dot inside the badge instead (r-head), and the stylesheet hides this one. */}}
{{define "sse"}}<span class="sse" id="sse" title="{{t "js.sse.title.on"}}"><span class="dot"></span></span>{{end}}

{{/* Settings belongs to the rail owner, outside the shared rail region.
The footer button survives usage redraws; the existing rail popover controller
keeps the card positioned and returns focus even after a rail replacement.
Layout/input preferences also remain available before a session is selected. */}}
{{define "account-consent"}}<section class="account-banner" data-openai-consent hidden aria-label="{{t "js.account.banner_title"}}" aria-live="polite"></section>{{end}}
{{define "daemon-confirm"}}<section class="daemon-confirm-banner" data-daemon-confirm data-ws-dom-exclude="1" hidden aria-label="{{t "js.dc.confirm.title"}}" aria-live="assertive"></section>{{end}}

{{define "settings"}}<div class="rpop settings-pop" id="gmenu" role="dialog" aria-label="{{t "drawer.settings"}}" tabindex="-1" hidden><div class="sphd">{{t "drawer.settings"}}<button type="button" class="usage-close" id="settings-close" aria-label="{{t "js.card.close"}}">×</button></div><div class="gmenu gcard">{{template "gearitems" .}}{{if .LoginLocal}}<a class="settings-page-link" href="/settings">{{icon "gear"}}{{t "js.settings.title"}}</a>{{end}}</div>{{if .LoginLocal}}<div class="gmenu gcard loginbox"><span class="gt">{{t "login.title"}}</span><button type="button" id="login-copy"><span class="gk"><svg class="i" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span><span>{{t "login.copy"}}<span class="gs">{{t "login.copy.sub"}}</span></span></button></div>{{end}}{{with .LAN}}<div class="lanbox"><b>{{t "lan.on"}}</b> {{t "lan.open"}}{{range .URLs}}<code class="lanurl">{{.}}</code>{{end}}<span class="lannote">{{tcode "lan.note" .TokenFile}}</span></div>{{end}}</div>{{end}}

{{define "gearitems"}}{{if .}}<span class="gt">{{t "gear.input"}}</span><button data-input="enter" aria-pressed="false"><span class="gk">&crarr;</span><span>{{t "gear.input.enter"}}<span class="gs">{{t "gear.input.enter.sub"}}</span></span></button><button data-input="mod" aria-pressed="false"><span class="gk">^&crarr;</span><span>{{t "gear.input.mod"}}<span class="gs">{{t "gear.input.mod.sub"}}</span></span></button>{{end}}<span class="gt{{if .}} gt2{{end}}">{{t "gear.theme"}}</span><button data-theme-set="" aria-pressed="false"><span class="gk">&#9680;</span><span>{{t "gear.theme.auto"}}<span class="gs">{{t "gear.theme.auto.sub"}}</span></span></button><button data-theme-set="light" aria-pressed="false"><span class="gk">&#9675;</span><span>{{t "gear.theme.light"}}</span></button><button data-theme-set="dark" aria-pressed="false"><span class="gk">&#9679;</span><span>{{t "gear.theme.dark"}}</span></button><span class="gt gt2">{{t "gear.motion"}}</span><button data-extra-motion="on" aria-pressed="true"><span class="gk">&#10022;</span><span>{{t "gear.motion.on"}}<span class="gs">{{t "gear.motion.on.sub"}}</span></span></button><button data-extra-motion="off" aria-pressed="false"><span class="gk">&#9675;</span><span>{{t "gear.motion.off"}}<span class="gs">{{t "gear.motion.off.sub"}}</span></span></button><span class="gt gt2">{{t "gear.language"}}</span><select id="glang" aria-label="{{t "gear.language"}}"><option value="">{{t "gear.lang.auto"}}</option>{{range langs}}<option value="{{.Code}}">{{.Name}}</option>{{end}}</select><span class="gn">{{t "gear.saved"}}<span class="meta settings-version">v{{.Version}}</span><a class="d-settings-github" href="{{repoURL}}" target="_blank" rel="noopener noreferrer" aria-label="{{t "gear.github"}}" title="{{t "gear.github"}}"><svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a></span>{{end}}

{{/* The drawer: the Ctrl+K quick-search sheet pulled down from the top, over
the page. The page script mounts the search body and its handle (#sbody,
#shandle) and the top fold button inside .dr-in; the handle hangs from the
top edge at the header's right end (the header pads its right side clear of
it). The panels region lives in the gallery's Workpanel (workpanel, below);
the pooled worktrees and the git region are the gallery's Git page (gitpage,
below); the session holders are the shell's bottom-bar Holders popup. */}}
{{define "drawer"}}<div class="drawer" id="drawer"><div class="dr-in"><div class="dr-clip" id="drclip"><div class="dr-sheet" id="drsheet" role="region" aria-label="{{t "js.tk.qs.tip"}}"></div></div></div></div>{{end}}

{{/* The Workpanel (Graybox B): the gallery's Workpanel system page, which
dashboard-workpanel.js adopts into its host (cards.js #wpdock) and unhides;
it stays hidden on a page without the gallery. The upper working memory holds
the panels region, rendered once: the region is a display: contents child of
the .wp-memory grid, so #p-todo and #p-agenda are its two cards, and every
chrome node (the narrow switch, the progress overlay, the expand-all button,
the empty placeholders) sits outside it, never inside the keyed rows
(dashboard-stream.js mergePanelRows). The lower reference card's Notes tab
reads the notes route (notes.go) and its Manuals tab the manuals route
(manuals.go), each on demand. */}}
{{define "workpanel"}}<div class="wp-root" id="wproot" hidden><header class="wp-head"><div class="wp-head-l"><svg class="wp-ic wp-head-ic" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2.2" width="12" height="11.6" rx="2"/><line x1="2" y1="7.8" x2="14" y2="7.8"/><line x1="8" y1="2.2" x2="8" y2="7.8"/></svg><h2 class="wp-title">{{t "wp.title"}}</h2><span class="wp-session-chip" id="wpsession" title="{{.ReplyID}}">{{or .Label .ReplyID}}</span></div><div class="wp-head-r"><span class="wp-sse" id="wpsse" title="{{t "wp.live.title"}}"><span class="wp-sse-dot" aria-hidden="true"></span><span class="wp-sse-lbl">{{t "wp.live"}}</span></span></div></header>
<div class="wp-mem-seg" role="tablist" aria-label="{{t "wp.mem.switch"}}"><button type="button" class="wp-seg-btn is-on" role="tab" data-mem-tab="todo" aria-selected="true"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.2 4.6 5.8 7.4 3"/><line x1="9.2" y1="4.4" x2="13.5" y2="4.4"/><path d="M3 8.4 4.6 10 7.4 7.2"/><line x1="9.2" y1="8.6" x2="13.5" y2="8.6"/><circle cx="4.5" cy="12.6" r="1.2"/><line x1="9.2" y1="12.6" x2="13.5" y2="12.6"/></svg><span>{{t "panel.todo"}}</span><span class="wp-count-pill" data-wp-count="todo"></span></button><button type="button" class="wp-seg-btn" role="tab" data-mem-tab="agenda" aria-selected="false"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3.5h10M3 8h7M3 12.5h9"/><circle cx="12.6" cy="8" r="1.4"/></svg><span>{{t "panel.agenda"}}</span><span class="wp-count-pill" data-wp-count="agenda"></span></button></div>
<section class="wp-memory" id="wpmemory" data-active-mem="todo" aria-label="{{t "wp.memory"}}"><div class="wp-mem-empty" data-for="todo"><div class="wp-mem-empty-hd">{{t "panel.todo"}}</div><div class="wp-empty"><svg class="wp-ic wp-empty-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.2 4.6 5.8 7.4 3"/><line x1="9.2" y1="4.4" x2="13.5" y2="4.4"/><path d="M3 8.4 4.6 10 7.4 7.2"/><line x1="9.2" y1="8.6" x2="13.5" y2="8.6"/><circle cx="4.5" cy="12.6" r="1.2"/><line x1="9.2" y1="12.6" x2="13.5" y2="12.6"/></svg><span class="wp-empty-title">{{t "wp.todo.empty"}}</span></div></div><div class="wp-mem-empty" data-for="agenda"><div class="wp-mem-empty-hd">{{t "panel.agenda"}}</div><div class="wp-empty"><svg class="wp-ic wp-empty-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3.5h10M3 8h7M3 12.5h9"/><circle cx="12.6" cy="8" r="1.4"/></svg><span class="wp-empty-title">{{t "wp.agenda.empty"}}</span></div></div>{{region . "panels"}}<div class="wp-mem-tools" data-for="todo" hidden><div class="wp-prog-wrap" role="progressbar" aria-label="{{t "wp.todo.progress"}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="wp-prog-track"><i class="wp-prog-fill" id="wpprog"></i></div></div><span class="wp-chip" data-wp-badge="todo"></span></div><div class="wp-mem-tools" data-for="agenda" hidden><button type="button" class="wp-ibtn" id="wpagall" title="{{t "wp.agenda.toggle"}}" aria-label="{{t "wp.agenda.toggle"}}"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.2 8 3l3.5 3.2M4.5 9.8 8 13l3.5-3.2"/></svg></button><span class="wp-chip" data-wp-badge="agenda"></span></div></section>
<section class="wp-ref-card" id="wpref" aria-label="{{t "wp.ref"}}"><header class="wp-ref-hd"><div class="wp-tabs" role="tablist" aria-label="{{t "wp.ref"}}"><button type="button" class="wp-tab is-on" role="tab" id="wptab-notes" data-ref-tab="notes" aria-selected="true" aria-controls="wppanel-notes"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 2.5h9.6v8.2L9.8 13.5H3.2z"/><path d="M9.8 10.7v2.8M9.8 10.7h3"/></svg><span>{{t "notes.title"}}</span><span class="wp-tab-cnt" data-wp-count="notes"></span></button><button type="button" class="wp-tab" role="tab" id="wptab-manuals" data-ref-tab="manuals" aria-selected="false" aria-controls="wppanel-manuals"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.8h6.2L13 6.5v6.7H3z"/><path d="M9.2 2.8v3.7H13M5.4 8.6h5.2M5.4 10.9h3.8"/></svg><span>{{t "wp.manuals"}}</span><span class="wp-tab-cnt" data-wp-count="manuals"></span></button></div><div class="wp-ref-acts" data-acts="notes"><span class="wp-sync-ts" id="wpnotests"></span><button type="button" class="wp-act-btn" id="wpnotesrefresh" title="{{t "notes.refresh"}}"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.4-3.5M13 2.5v2.8h-2.8"/></svg><span>{{t "notes.refresh"}}</span></button></div><div class="wp-ref-acts" data-acts="manuals" hidden><span class="wp-path-chip">ai-docs/manuals/</span></div></header>
<div class="wp-tabpanel" id="wppanel-notes" role="tabpanel" aria-labelledby="wptab-notes"><div class="wp-toolbar"><div class="wp-search-row"><div class="wp-search-well"><svg class="wp-ic wp-search-ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7.2" cy="7.2" r="4.3"/><path d="m10.5 10.5 3.1 3.1"/></svg><input type="search" id="wpnotesq" class="wp-search-inp" placeholder="{{t "wp.notes.search"}}" aria-label="{{t "wp.notes.search"}}" autocomplete="off"><button type="button" class="wp-search-clr" data-clear="wpnotesq" hidden title="{{t "wp.search.clear"}}" aria-label="{{t "wp.search.clear"}}">&times;</button></div><button type="button" class="wp-filter-toggle" id="wpnotesmuted" aria-pressed="true" title="{{t "wp.notes.muted.title"}}"><svg class="wp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8s2.3-3.8 6-3.8S14 8 14 8s-2.3 3.8-6 3.8S2 8 2 8z"/><circle cx="8" cy="8" r="1.5"/></svg><span>{{t "wp.notes.muted"}}</span></button></div><div class="wp-chips-row" role="group" aria-label="{{t "wp.notes.layers"}}" id="wpnoteslayers"><button type="button" class="wp-lchip is-on" data-layer="all" aria-pressed="true">{{t "wp.notes.all"}} <em data-lcnt="all">0</em></button><button type="button" class="wp-lchip" data-layer="worktree" aria-pressed="false">{{t "js.notes.worktree"}} <em data-lcnt="worktree">0</em></button><button type="button" class="wp-lchip" data-layer="repo" aria-pressed="false">{{t "js.notes.repo"}} <em data-lcnt="repo">0</em></button><button type="button" class="wp-lchip" data-layer="clone" aria-pressed="false">{{t "js.notes.clone"}} <em data-lcnt="clone">0</em></button><button type="button" class="wp-lchip" data-layer="machine" aria-pressed="false">{{t "js.notes.machine"}} <em data-lcnt="machine">0</em></button></div></div><div class="wp-ref-body" id="wpnoteslist" aria-live="polite"></div></div>
<div class="wp-tabpanel" id="wppanel-manuals" role="tabpanel" aria-labelledby="wptab-manuals" hidden><div class="wp-toolbar"><div class="wp-search-row"><div class="wp-search-well"><svg class="wp-ic wp-search-ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7.2" cy="7.2" r="4.3"/><path d="m10.5 10.5 3.1 3.1"/></svg><input type="search" id="wpmanualsq" class="wp-search-inp" placeholder="{{t "wp.manuals.search"}}" aria-label="{{t "wp.manuals.search"}}" autocomplete="off"><button type="button" class="wp-search-clr" data-clear="wpmanualsq" hidden title="{{t "wp.search.clear"}}" aria-label="{{t "wp.search.clear"}}">&times;</button></div></div></div><div class="wp-ref-body" id="wpmanualslist" aria-live="polite"></div></div></section></div>{{end}}

{{/* The gallery's Git page (dashboard-gitpage.js moves it into #bgal's
#gitdock when the gallery mounts; dashboard-gitpage.css lays it out): the
action strip (the standing line, the fetch, pull and push icon buttons, the
review ledger's pill that jumps to the frontier commit, and the Worktrees
button with its popover), then the commit graph, the page's one panel at
every width. The git region inside it is its live data carrier (gitbadge.go):
no markup of its own shows. The page script draws the graph rows (git/log),
one working-tree row above HEAD while the tree is dirty (git/status), and the
pooled worktrees once the popover opens (the cache-only pool read; its
Refresh button runs the measuring scan); a commit row or the working-tree row
opens the commit window. No commit action, and the graph is read-only. */}}
{{define "gitpage"}}<div class="gp-page" id="gitpage" hidden>{{region . "git"}}<header class="gp-strip"><div class="gp-strip-main"><span class="gp-ref" id="gpref"></span><span class="gp-acts"><button type="button" class="btn gact" data-git="fetch" data-busy="{{t "git.fetch.busy"}}" title="{{t "git.fetch.title"}}" aria-label="{{t "git.fetch"}}">{{icon "fetch"}}</button><button type="button" class="btn gact" data-git="pull" data-busy="{{t "git.pull.busy"}}" title="{{t "git.pull.title"}}" aria-label="{{t "git.pull"}}">{{icon "pull"}}</button><button type="button" class="btn gact gp-primary" data-git="push" data-busy="{{t "git.push.busy"}}" title="{{t "git.push.title"}}" aria-label="{{t "git.push.go"}}">{{icon "push"}}</button></span></div><button type="button" class="gp-pill" id="gppill" data-state="loading" disabled><span class="gp-pill-dot"></span><span class="gp-pill-tx" id="gppilltx">{{t "gp.ledger.loading"}}</span><span class="gp-pill-go" aria-hidden="true">↗</span></button><span class="gp-wtwrap"><button type="button" class="gp-wtbtn" id="gpwtbtn" aria-haspopup="dialog" aria-controls="gpwtpop" aria-expanded="false" title="{{t "gp.wt.open"}}" aria-label="{{t "gp.wt.open"}}">{{icon "folder"}}<span class="chip gp-chip" id="wtcount" hidden></span></button><div class="gp-wtpop" id="gpwtpop" role="dialog" aria-label="{{t "gp.wt.panel"}}" hidden><div class="gp-hd">{{icon "folder"}}<h3 class="gp-title">{{t "wt.title"}}</h3><span class="gp-sp"></span>{{if .Worktrees}}<span class="gp-mode" id="gpwtmode" data-mode="light"><span class="gp-mode-dot"></span><span id="gpwtmodetx">{{t "gp.wt.mode.light"}}</span></span>{{end}}</div>{{if .Worktrees}}<div class="gp-scanbar"><button type="button" class="gp-scan" id="gpscan" title="{{t "gp.wt.scan.title"}}"><span class="gp-scan-prog"></span><span class="gp-scan-ic"><svg class="i li" aria-hidden="true"><use href="#l-refresh-cw"/></svg></span><span class="gp-scan-copy"><span class="gp-scan-title">{{t "gp.wt.scan"}}</span><span class="gp-scan-sub" id="gpscansub">{{t "gp.wt.scan.sub"}}</span></span><span class="gp-scan-tag" id="gpscantag">WalkDir</span></button></div><div class="wtlist" id="wtlist" aria-live="polite"></div><div class="wtfoot"><span class="wtnote" id="wtnote" role="status">{{t "gp.wt.unscanned"}}</span><button type="button" class="btn wtclean" id="wtclean"{{if .Adapter}} title="{{t "wt.cleanup.title"}}"{{else}} disabled title="{{t "wt.cleanup.noadapter"}}"{{end}}>{{t "wt.cleanup"}}</button></div>{{else}}<div class="gp-none">{{t "gp.wt.none"}}</div>{{end}}</div></span></header><div class="gmsg" id="gmsg" role="status" data-lost="{{t "git.lost"}}" hidden></div><section class="gp-card glog" id="glog" aria-label="{{t "git.graph"}}"><div class="gp-hd">{{icon "branch"}}<h3 class="gp-title">{{t "git.graph.title"}}</h3><span class="chip gp-chip" id="glcount" hidden></span><span class="gp-sp"></span><button type="button" class="gp-fmini" id="gpfmini" title="{{t "gp.frontier.jump"}}" hidden><span class="gp-fdot"></span><span id="gpfminitx"></span></button></div><div class="glscroll" id="glscroll"><div class="glcols"><span>{{t "git.graph.col.graph"}}</span><span>{{t "git.graph.col.subject"}}</span><span class="gp-col-author">{{t "git.graph.col.author"}}</span><span class="r">{{t "git.graph.col.when"}}</span><span class="r gp-col-hash">{{t "git.graph.col.commit"}}</span></div><div class="glrows" id="glrows"></div></div></section><div class="gp-empty" id="gpempty" hidden>{{icon "repo"}}<b>{{t "gp.norepo"}}</b><span>{{t "gp.norepo.sub"}}</span></div><div class="gp-toast" id="gptoast" role="status" hidden></div></div>{{end}}

{{/* The drawer's own card: the session holders, when the daemon runs
them. It is no region (the pooled worktrees are the Git page's, gitpage
above, and the notes the Workpanel's, workpanel above): the page script
fills the holders card from the holders route (holders.go) each time the
drawer opens: the holders no daemon is attached to, the ones not
restart-safe, and the failed holder starts; a stop button on an unattached
row, for a viewer the route lets stop one. */}}

{{/* stitle is a session page's tab title: its display label, or its
reply-id when it has none. The head's name carries it too (data-title), so
the page script retitles the tab when a head swap brings a new label. */}}
{{define "stitle"}}{{or .Label .ReplyID}} - Werkschaft (alpha){{end}}

{{define "worktree-head"}}<span class="tph tph-id"><span class="tph-c"><span class="meta tph-r1">{{.Workspace}}</span><b class="worktree-branch">{{icon "branch"}}{{.WorktreeBranch}}</b></span></span><span class="tph tph-chips"><span class="meta worktree-path" title="{{.Worktree}}">{{.Worktree}}</span><span class="chip">{{t "worktree.page"}}</span><span class="chip">{{t "worktree.local"}}</span></span>{{end}}

{{/* The head's session name (sname): the display label, or the reply-id
when the session has none, as a button whose click copies the session's
mailbox address (MailboxRef); its tooltip keeps the reply-id. A label
marks the name lbl, the body face (dashboard.css), as the rail and index
rows mark theirs. The pencil
beside it opens the page script's inline rename (dashboard.js labelStart),
which posts to the label route (label_route.go). */}}
{{define "sname"}}<span class="meta sname" data-label="{{.Label}}" data-max="{{.LabelMax}}" data-title="{{template "stitle" .}}"><button type="button" class="snm{{if .Label}} lbl{{end}}" data-copy="{{.MailboxRef}}" data-mailbox-open="{{.MailboxOpen}}" title="{{.ReplyID}}&#10;{{t "head.name.copy"}}">{{or .Label .ReplyID}}</button><button type="button" class="sren" title="{{t "head.rename"}}" aria-label="{{t "head.rename"}}">{{icon "pencil"}}</button>{{if .HasBoard}}<span class="sseq"> · #{{.Seq}}</span>{{end}}</span>{{end}}

{{/* parentpill is the head's parent jump: an up-left arrow and the parent's
name under a micro-label. Linked or not, the markup is the same; only the
element around it (a link or an inert badge) differs. */}}
{{define "parentpill"}}<svg class="tph-up" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.5 11.5 4.5 4.5M4.5 10.5v-6h6"/></svg><span class="tph-c"><span class="meta tph-r1">{{t "head.parent"}}</span><b class="tph-pn">{{.Name}}</b></span>{{end}}
{{define "r-head"}}{{with .Parent}}{{if .Linked}}<a class="tph tph-parent" href="/s/{{.ReplyID}}" title="{{t "head.parent.title" .Name}}{{with .Path}}&#10;{{.}}{{end}}">{{template "parentpill" .}}</a>{{else}}<span class="tph tph-parent dead" title="{{t "head.parent.gone" .Name}}{{with .Path}}&#10;{{.}}{{end}}">{{template "parentpill" .}}</span>{{end}}{{end}}<span class="tph tph-id"{{with .Model}} data-companion-model="{{.}}"{{end}}><span class="tph-c"><span class="meta tph-r1">{{.ProjectName}}</span>{{template "sname" .}}</span></span>{{$br := ""}}{{if and .Git (eq .Git.State "ok") .Git.Branch}}{{$br = .Git.Branch}}{{else if and .Band.Repo .Band.Repo.Branch (or (not .Git) (ne .Git.State "norepo"))}}{{$br = .Band.Repo.Branch}}{{end}}{{if $br}}<span class="tph tph-branch"><span class="worktree-branch" title="{{$br}}">{{icon "branch"}}<span class="wbr-tx">{{$br}}</span></span></span>{{end}}{{if or .Harness .Hosted}}<span class="tph tph-hs">{{with .Harness}}<span class="hb" data-h="{{.}}" aria-hidden="true"></span><span class="host sse{{if not $.ProcessRunning}} stopped{{end}}{{with $.Host}}{{if .Failure}} err{{end}}{{end}}" title="{{if $.ProcessRunning}}{{t "head.process.running"}}{{else}}{{t "head.process.stopped"}}{{end}}"><span class="dot"></span>{{.}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}</span>{{end}}<span class="tph tph-chips">{{with .Host}}{{with .Failure}}<span class="chip fail" title="{{.Text}}">{{template "noticeword" .Kind}}</span>{{end}}{{with .QuotaContinuation}}{{if and (eq .Status "scheduled") (gt .ResumeAt 0)}}<span class="chip qc-chip scheduled" data-qc-status="scheduled" data-qc-resume="{{.ResumeAt}}">{{t "quota.chip.scheduled"}} · <time class="t" data-ms="{{.ResumeAt}}" data-f="dt">{{clock .ResumeAt}}</time></span>{{else if eq .Status "exhausted"}}<span class="chip qc-chip exhausted" data-qc-status="exhausted">{{t "quota.chip.exhausted"}}</span>{{end}}{{end}}{{with .MCPBroken}}<span class="chip mcpbad" title="{{t "head.mcp.title"}} {{range $i, $s := .}}{{if $i}}, {{end}}{{$s}}{{end}}">{{t "head.mcp"}}</span>{{end}}{{end}}{{if eq .Lifecycle "pending_deletion"}}<span class="ended-chip" title="{{t "head.ended.title"}}">{{t "head.ended"}}</span>{{else if eq .Lifecycle "stopped"}}<span class="ended-chip" title="{{t "head.stopped.title"}}">{{t "head.stopped"}}</span>{{end}}{{if not .Adapter}}<span class="nolive" title="{{t "head.stores.title"}}">{{t "head.stores"}}</span>{{end}}{{if or .CountPolicy .CountAcks}}<span class="counts">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}</span>{{end}}</span>{{if and .IsChild .ChildCloseKnown (not .ChildClosed)}}<button type="button" class="tph tph-close child-close" data-child-close data-reply-id="{{.ReplyID}}" data-label="{{or .Label .ReplyID}}" data-state="{{if not .ChildActive}}idle{{else if eq .Lead.Phase "permission"}}permission{{else if or .Tree.Subagents.Direct .Tree.Subagents.Deep}}holding{{else if eq .Lead.Phase "tool"}}tool{{else}}thinking{{end}}" title="{{t "js.subagent.close"}}" aria-label="{{t "js.subagent.close"}}"><svg class="tph-x" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg><span class="tph-close-lbl">{{t "js.subagent.close"}}</span></button>{{end}}{{end}}

{{define "r-board"}}{{if .HasBoard}}{{.ThemedBoard}}{{else}}<div class="empty">{{t "board.empty"}}</div>{{end}}{{end}}

{{define "r-panels"}}{{.Panels}}{{end}}

{{define "phase"}}{{if eq . "permission"}}<span class="phase permission">{{icon "lock"}}{{t "phase.approval"}}</span>{{else if eq . "thinking"}}<span class="phase thinking"><span class="spin"></span>{{t "phase.thinking"}}</span>{{else if eq . "replying"}}<span class="phase replying"><span class="spin"></span>{{t "phase.replying"}}</span>{{else if eq . "tool"}}<span class="phase tool"><span class="spin"></span>{{t "phase.tool"}}</span>{{else if eq . "compacting"}}<span class="phase compacting"><span class="spin"></span>{{t "phase.compacting"}}</span>{{else}}<span class="phase idle"><span class="idle-dot"></span>{{t "phase.idle"}}</span>{{end}}{{end}}

{{define "dur"}}<time class="t" data-ms="{{.}}" data-f="since">{{clock .}}</time>{{end}}
{{define "ago"}}<time class="t" data-ms="{{.}}" data-f="ago">{{clock .}}</time>{{end}}
{{define "clock"}}<time class="t" data-ms="{{.}}" data-f="clock">{{clock .}}</time>{{end}}
{{define "span"}}<span class="t" data-span="{{.}}">{{spanText .}}</span>{{end}}

{{define "batch"}}{{if .Failed}}<li class="brow fail"><span class="mk">✗</span>{{else}}<li class="brow done"><span class="mk">✓</span>{{end}}<span class="bp">{{range .ToolNames}}<span class="tool" title="{{.}}">{{toolName .}}</span>{{end}}</span><span class="bm">{{tn "batch.calls" .CallCount}}{{with .Failed}} · {{t "count.failed" .}}{{end}} · {{template "ago" .EndedAt}}</span></li>{{end}}

{{/* The live rows: permrow a pending permission prompt, runrow the running
call, genrow a tool call streaming its arguments. liverows is a lead's
variable list (the expanded peer tree); slots a running agent's fixed rows
(AgentNode.Slots), where a slot with nothing set is a dim placeholder. */}}
{{define "permrow"}}<li class="brow live perm"><span class="mk">{{icon "lock"}}</span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.approval"}}{{with .ArgsPreview}} · {{.}}{{end}}</span></span><span class="bm">{{template "dur" .StartedAt}}</span></li>{{end}}

{{define "runrow"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{.ArgsPreview}}</span></span><span class="bm">{{with .OthersRunning}}+{{.}} · {{end}}{{template "dur" .StartedAt}}</span></li>{{end}}

{{define "genrow"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.args"}}</span></span><span class="bm">{{t "live.chars" .Chars}} · {{template "dur" .PhaseStartedAt}}</span></li>{{end}}

{{define "liverows"}}{{with .Permission}}{{template "permrow" .}}{{end}}{{with .Running}}{{template "runrow" .}}{{end}}{{with .Generating}}{{if eq .Kind "tool"}}{{template "genrow" .}}{{end}}{{end}}{{end}}

{{define "slots"}}{{range .}}{{if .Permission}}{{template "permrow" .Permission}}{{else if .Finished}}{{template "batch" .Finished}}{{else if .Running}}{{template "runrow" .Running}}{{else if .Generating}}{{template "genrow" .Generating}}{{else}}<li class="brow ph"><span class="mk">-</span></li>{{end}}{{end}}{{end}}

{{/* tphase is the agents popover's phase pill: phase without the spinner, since
in the popover only a live tool row spins and an agent's mark is a pulsing dot.
The session index row keeps phase. */}}
{{define "tphase"}}{{if or (eq . "thinking") (eq . "replying") (eq . "tool") (eq . "compacting")}}<span class="phase {{.}}">{{t (printf "phase.%s" .)}}</span>{{else}}{{template "phase" .}}{{end}}{{end}}

{{define "r-tree"}}<div class="ag-source" hidden data-sub="{{.Tree.Subagents.Direct}}" data-subdeep="{{.Tree.Subagents.Deep}}"><script type="application/json" class="ag-hud-data">{{hudJSON .Tree.HUD}}</script>{{range .Tree.CompactAgents}}<div class="compact-agent"><summary class="ahead"><span class="aline"><span class="amk">{{if .Harness}}<span class="hb sm" data-h="{{.Harness}}"></span>{{else}}<span class="pulse"></span>{{end}}</span><span class="aname">{{if .Label}}{{.Label}}{{else}}{{t "agent.name" (shortID .ID)}}{{end}}</span>{{template "tphase" .Phase}}</span><span class="am">{{if .ActiveSince}}{{template "dur" .ActiveSince}}{{else}}{{template "span" .ActiveMs}}{{end}}</span></summary></div>{{end}}</div><div class="thead">{{icon "agents"}}{{t "tree.agents"}}<span class="sum"><span class="chip crun">{{t "tree.running" .Tree.Running}}</span><span class="chip cdone">{{t "tree.done" .Tree.Finished}}</span><span class="chip cfail">{{t "tree.failed" .Tree.Failed}}</span><span class="chip">{{icon "mail"}}{{len .Tree.Peers.Live}}</span>{{with .Tasks}}<span class="chip bgt" title="{{t "tree.bg.title"}}">{{t "tree.bgchip" .}}</span>{{end}}</span></div><div class="tree"><div class="agent root {{.Lead.Phase}}"><details data-key="agent-lead"><summary class="ahead"><span class="amk">{{template "mark" .Lead.Phase}}</span><span class="aname">{{t "tree.lead"}}</span>{{template "tphase" .Lead.Phase}}<span class="ldet">{{if .Lead.Permission}}<span class="tn" title="{{.Lead.Permission.ToolName}}">{{toolName .Lead.Permission.ToolName}}</span> <span class="args">{{.Lead.Permission.ArgsPreview}}</span>{{else if .Lead.Running}}<span class="tn" title="{{.Lead.Running.ToolName}}">{{toolName .Lead.Running.ToolName}}</span> <span class="args">{{.Lead.Running.ArgsPreview}}</span>{{else if and .Lead.Generating (eq .Lead.Generating.Kind "tool")}}<span class="tn" title="{{.Lead.Generating.ToolName}}">{{toolName .Lead.Generating.ToolName}}</span> <span class="args">{{t "live.args"}}</span>{{end}}</span><span class="am">{{if .Lead.Permission}}{{template "dur" .Lead.Permission.StartedAt}}{{else if .Lead.Running}}{{template "dur" .Lead.Running.StartedAt}}{{else if and .Lead.PhaseStartedAt (or (eq .Lead.Phase "thinking") (eq .Lead.Phase "replying") (eq .Lead.Phase "tool") (eq .Lead.Phase "compacting"))}}{{template "dur" .Lead.PhaseStartedAt}}{{end}}<span title="{{t "tree.batches.title"}}">{{tn "tree.batches" (len .Lead.Finished)}}</span>{{icon "chev"}}</span></summary><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}</ol>{{template "afull" .Lead.Finished}}</details></div>{{with .Tree.RunningAgents}}<div class="tgroup run"><div class="pghead">{{t "tree.group.running" (len .)}}</div>{{range .}}{{template "agent" .}}{{end}}</div>{{end}}{{with .Tree.EndedAgents}}<div class="tgroup ended"><div class="pghead">{{t "tree.group.ended" (len .)}}</div>{{range .}}{{template "agent" .}}{{end}}</div>{{end}}{{if or .Background .Monitors}}<div class="tgroup bg"><div class="pghead">{{t "tree.group.bg" .Tasks}}</div>{{with .Background}}<div class="tbg">{{icon "clock"}}<span title="{{t "tree.bg.title"}}">{{tn "tree.bg" .}}</span></div>{{end}}{{with .Monitors}}<div class="tbg">{{icon "clock"}}<span title="{{t "tasks.monitors.title"}}">{{tn "js.monitors" .}}</span></div>{{end}}</div>{{end}}{{template "peers" .Tree.Peers}}</div>{{end}}

{{define "aended"}}{{if eq . "unknown"}}{{t "agent.unknown"}}{{else if eq . "background"}}{{t "agent.background"}}{{else if eq . "sleep"}}{{t "agent.sleep"}}{{else if eq . "deleted"}}{{t "agent.deleted"}}{{else if eq . "failed"}}{{t "agent.failed"}}{{else}}{{t "agent.done"}}{{end}}{{end}}

{{define "mark"}}{{if eq . "permission"}}{{icon "lock"}}{{else if or (eq . "idle") (eq . "")}}<span class="idle-dot"></span>{{else}}<span class="pulse"></span>{{end}}{{end}}

{{define "agent"}}<div class="agent {{.Status}}{{if .Native}} native{{end}}{{if .EndUnknown}} d-unknown{{end}}"{{if .EndUnknown}} data-end-unknown="1"{{end}}><details data-key="agent-{{.ID}}"><summary class="ahead"><span class="aline"><span class="amk">{{if .IsRunning}}{{if .Harness}}<span class="hb sm" data-h="{{.Harness}}"></span>{{else}}<span class="pulse"></span>{{end}}{{else if eq .Status "failed"}}✗{{else if .EndUnknown}}?{{else}}✓{{end}}</span><span class="aname" title="{{or .Label .ID}}">{{if .Label}}{{.Label}}{{else}}{{t "agent.name" (shortID .ID)}}{{end}}</span>{{if .Native}}<span class="nbadge" title="{{t "agent.native.title"}}">{{t "agent.native"}}</span>{{end}}{{with .ReplyID}}{{if $.Linked}}<a class="arid" href="/s/{{.}}" title="{{t "agent.open" .}}">{{shortID .}}</a>{{else}}<span class="arid nob" title="{{.}}">{{shortID .}}</span>{{end}}{{end}}{{if .IsRunning}}{{template "tphase" .Phase}}{{else if or (eq .AgentKind "pi") (gt .BackgroundTasks 0) .EndUnknown}}<span class="chip astatus"{{if .EndUnknown}} title="{{template "aended" .EndedStatus}}"{{end}}>{{if .EndUnknown}}{{t "agent.unknown.short"}}{{else}}{{template "aended" .EndedStatus}}{{end}}</span>{{end}}{{with .Caption}}<span class="acap" title="{{.}}">{{.}}</span>{{end}}{{if .Native}}{{template "alife" .}}{{end}}</span>{{template "astat" .}}<span class="am"><span class="ok" title="{{t "agent.done"}}">✓ {{.Done}}</span><span class="{{if .Failed}}f{{end}}" title="{{t "agent.failed"}}">✗ {{.Failed}}</span>{{if or .IsRunning .ActiveMs}}<span>{{with .ActiveSince}}{{template "dur" .}}{{else}}{{template "span" $.ActiveMs}}{{end}}</span>{{end}}{{icon "chev"}}</span>{{with .ReplyID}}<button type="button" class="aclose" hidden data-reply-id="{{.}}" data-label="{{or $.Label $.ID}}" data-state="{{if $.Permission}}permission{{else if $.Holding}}holding{{else if $.IsRunning}}thinking{{else}}idle{{end}}" title="{{if or $.IsRunning $.Holding $.Permission}}{{t "js.subagent.close.active" (or $.Label $.ID)}}{{else}}{{t "js.subagent.close.ended" (or $.Label $.ID)}}{{end}}" aria-label="{{if or $.IsRunning $.Holding $.Permission}}{{t "js.subagent.close.active" (or $.Label $.ID)}}{{else}}{{t "js.subagent.close.ended" (or $.Label $.ID)}}{{end}}">×</button>{{end}}</summary><ol class="brows">{{range .Finished}}{{template "batch" .}}{{end}}</ol>{{template "afull" .Finished}}</details>{{if and .IsRunning (not .Native)}}<ol class="brows live bguide">{{template "slots" .Slots}}</ol>{{end}}{{with .Children}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}{{template "agent-model-hover" .}}</div>{{end}}

{{/* alife is a native subagent row's lifecycle: its start and, once known,
its end; the row's mark (✓, ✗) is its state. A terminal native row without
an end shows only its start, a ? mark, and a status chip that reads
observation ended, completion unknown. */}}
{{define "alife"}}<span class="alife">{{with .StartedAt}}<span>{{t "agent.native.started"}} {{template "clock" .}}</span>{{end}}{{if not (or .IsRunning .EndUnknown)}}{{with .EndedAt}}<span>{{t "agent.native.ended"}} {{template "clock" .}}</span>{{end}}{{end}}</span>{{end}}

{{/* astat is a subagent row's telemetry: model, effort, context size, and
(while it runs) output rate, each its own stat and left out while unknown;
effort stays out of the model's ellipsis so a long model ID cannot cut it. On a narrow
agents popover a container query moves it to a second line under the row
name; aline wraps the leading items so that line can sit below them. */}}
{{define "astat"}}{{if .HasStats}}<span class="astat">{{with .DisplayModel}}<span class="amodel" title="{{if $.Observed}}{{t "hover.observed"}}{{else}}{{t "agent.model" .}}{{end}}">{{.}}</span>{{end}}{{with .Effort}}<span class="aeff" title="{{t "agent.effort" .}}">{{.}}</span>{{end}}{{with .ContextText}}<span class="actx" title="{{t "agent.context" $.ContextTokens}}">{{.}}</span>{{end}}{{with .Rate}}<span class="atps" title="{{t "agent.rate" .}}">{{.}} t/s</span>{{end}}{{if not (or .IsRunning .EndUnknown)}}{{with .EndedAt}}<span>{{template "ago" .}}</span>{{end}}{{end}}</span>{{end}}{{end}}

{{define "peers"}}<div class="pgroup"><div class="pghead">{{icon "mail"}}{{t "peers.title"}}<span class="chip">{{len .Live}}</span>{{with .Ended}}<span class="chip">{{t "peers.ended" (len .)}}</span>{{end}}</div>{{range .Rows}}{{template "peer" .}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "peers.hidden" .}}</div>{{end}}</div>{{end}}

{{define "pfolder"}}{{with .Folder}}<span class="pfolder">{{.}}/</span>{{end}}{{end}}

{{/* pbranch is a served peer's branch chip, drawn as the session page's git
handle draws a branch: goal and impl branches by their last segment with
their marks, a detached HEAD by its commit with the detached title, and no
chip for a root that is no repository. */}}
{{define "pbranch"}}{{with .BranchHandle}}{{if .Text}}<span class="pbr" title="{{if $.Detached}}{{t "git.detached" $.Branch}}{{else}}{{$.Branch}}{{end}}">{{if .Goal}}<span class="gh-goal">{{icon "trophy"}}</span>{{end}}{{if .Impl}}<span class="gh-impl">{{icon "hammer"}}</span>{{end}}{{if not (or .Goal .Impl)}}{{icon "branch"}}{{end}}<span class="pbt">{{.Text}}</span></span>{{end}}{{end}}{{end}}

{{/* peerrow is a peer's one-line row. A row whose name is a manual label
(PeerRow.Label) carries the labeled class on its peer element, and the
stylesheet then gives way in a fixed order as the row narrows: the harness
badge (phost, which wraps it so the badge's padding collapses too), the tool
text, the phase pill, the branch chip, and the name last. */}}
{{define "peerrow"}}<span class="amk">{{if and .Live .Adapter}}{{template "mark" .Lead.Phase}}{{else}}<span class="pdot"></span>{{end}}</span>{{if .Served}}<a class="pname" href="/s/{{.ReplyID}}"{{with .Title}} title="{{.}}"{{end}}>{{template "pfolder" .}}{{.Name}}</a>{{else}}<span class="pname"{{with .Title}} title="{{.}}"{{end}}>{{template "pfolder" .}}{{.Name}}</span>{{end}}{{template "pbranch" .}}{{if and .Harness .Live}}<span class="phost"><span class="host sm">{{.Harness}}</span></span>{{end}}{{if not .Compact}}<span class="pline">{{if eq .Lifecycle "pending_deletion"}}<span class="pstate">{{t "head.ended"}}</span>{{else if eq .Lifecycle "stopped"}}<span class="pstate">{{t "head.stopped"}}</span>{{else if not .Served}}<span class="pstate">{{t "peer.unserved"}}</span>{{else if and .Live .Adapter}}{{template "tphase" .Lead.Phase}}{{with .Lead.Running}}<span class="ptool" title="{{.ToolName}}">{{toolName .ToolName}}</span>{{end}}{{end}}</span>{{end}}<span class="am">{{if .RunningAgents}}<span class="prun" title="{{tn "peer.running" .RunningAgents}}">{{icon "agents"}}{{.RunningAgents}}</span>{{end}}{{if and .Adapter (not .Compact)}}<span title="{{t "peer.subagents"}}">{{icon "agents"}}{{.AgentCount}}</span>{{end}}<span title="{{t "peer.lastmail"}}">{{icon "mail"}}{{template "ago" .LastExchange}}</span></span>{{end}}

{{/* subbadge is the running-subagent badge on the composer's top border,
beside the interrupt badge: the page script fills its label from a convlive
region's data-sub and data-subdeep and hides it while nothing runs. Any
composer that shows a session's conversation may carry it; the tracker's
support chat card builds a plain span of it, without the id or a popover,
in script (supChat). On the session page it is a button that opens the agents
popover (agpop); there it stays shown while nothing runs, so the popover is
always reachable. */}}
{{define "subbadge"}}<span class="sbwrap"><button type="button" class="sbadge" id="sbadge" title="{{t "js.subagents.title"}}" aria-haspopup="dialog" aria-expanded="false" aria-controls="agpop" hidden><span class="spin"></span>{{icon "agents"}}<span class="slabel"></span><span class="sword">{{t "subbadge.running"}}</span></button>{{if .SysOpen}}<button type="button" class="bgbadge" id="bgbadge" title="{{t "tree.bg.title"}}" aria-haspopup="dialog" aria-expanded="false" aria-controls="bgpop" hidden>{{icon "clock"}}<span class="blabel"></span></button>{{else}}<span class="bgbadge" id="bgbadge" title="{{t "tree.bg.title"}}" hidden>{{icon "clock"}}<span class="blabel"></span></span>{{end}}<span class="bgbadge" id="monbadge" title="{{t "tasks.monitors.title"}}" hidden>{{icon "clock"}}<span class="blabel"></span></span></span>{{end}}

{{/* agpop is the session's agents popover: the agents region (r-tree) over
the conversation, above the subagent badge that opens it. Its pin and close
controls and its hint sit outside the region so a region swap never takes
their focus or state; the page script (dashboard-composer-status.js) opens, closes
and pins it. */}}
{{define "agpop"}}<div class="agpop" id="agpop" role="dialog" aria-label="{{t "tree.agents"}}" hidden>{{region . "tree"}}<div class="agctl"><button type="button" class="agpin" id="agpin" aria-pressed="false" title="{{t "agpop.pin"}}" aria-label="{{t "agpop.pin"}}"><svg class="li" aria-hidden="true"><use href="#l-pin"/></svg></button><button type="button" class="agclose" id="agclose" title="{{t "agpop.close"}}" aria-label="{{t "agpop.close"}}">×</button></div><div class="agfoot">{{t "agpop.hint"}}</div></div>{{end}}

{{/* afull follows an expanded agent's finished batches: inside the agents
popover only the newest few show, and this action shows the rest. */}}
{{define "afull"}}{{if gt (len .) 4}}<button type="button" class="afull" data-full>{{t "tree.full"}}</button>{{end}}{{end}}

{{define "peer"}}{{if and .Served .Adapter (not .Compact)}}<details class="peer {{if .Live}}live{{else}}ended{{end}}{{if .Label}} labeled{{end}}" data-peer="{{.ReplyID}}"><summary>{{template "peerrow" .}}</summary><div class="ptree"><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}{{template "liverows" .Lead}}</ol>{{with .Agents}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}</div></details>{{else}}<div class="peer {{if .Live}}{{if .Compact}}live compact{{if not .Adapter}} nophase{{end}}{{else if .Served}}live nophase{{else}}unserved{{end}}{{else}}ended{{end}}{{if .Label}} labeled{{end}}">{{template "peerrow" .}}</div>{{end}}{{end}}

{{/* The conversation's two regions share the #convo scroll wrapper. entries
holds the finished messages, each keyed by data-entry (its ring entry name);
the page merges it by key, replacing only changed mail-wake presentations.
convlive is the rest, swapped whole: a streaming tick changes it alone. Its data-phase is
the lead's phase, which shows or hides the composer's interrupt badge;
data-turn, present while a turn runs, is that turn's start stamp, which
re-enables the badge when a new turn starts right after an interrupted one;
and data-sub and data-subdeep the running subagents (SubagentCount), which
drive the subagent badge beside it. */}}
{{define "r-entries"}}<div class="thead">{{icon "chat"}}{{t "tab.conversation"}}<span class="sum"><span class="chip">{{t "convo.user" .Conversation.Users}}</span><span class="chip">{{icon "mail"}}{{.Conversation.Mails}}</span>{{with .ModelHistory}}<button type="button" class="chip modelhistory-trigger" title="{{t "hover.history"}}" aria-label="{{t "hover.history"}}" aria-haspopup="dialog" aria-expanded="false" aria-controls="modelhistory-popover">{{icon "clock"}}</button><template class="shp-source modelhistory-source"><div class="modelhistory"><div class="shp-hd"><b class="shp-nm">{{t "hover.history"}}</b></div>{{range .}}<section class="modelhistory-agent"><div class="modelhistory-label">{{if .ID}}{{or .Label .ID}}{{else}}{{t "tree.lead"}}{{end}}</div><ol class="brows">{{template "observed-history" .Observed}}</ol></section>{{end}}</div></template>{{end}}</span></div><div class="conv centries">{{range .Conversation.Entries}}{{.Rendered}}{{end}}</div>{{end}}

{{define "r-convlive"}}<div class="conv clive" data-phase="{{.Conversation.Phase}}" data-sub="{{.Conversation.Subagents.Direct}}" data-subdeep="{{.Conversation.Subagents.Deep}}"{{with .Lead.TurnStartedAt}} data-turn="{{.}}"{{end}}{{with .Host}}{{with .Failure}} data-qc-fail="{{.Kind}}"{{if gt .ResetsAt 0}} data-qc-reset="{{.ResetsAt}}"{{end}}{{end}}{{with .QuotaContinuation}} data-qc-status="{{.Status}}"{{if gt .ResumeAt 0}} data-qc-resume="{{.ResumeAt}}"{{end}}{{if gt .Attempts 0}} data-qc-att="{{.Attempts}}"{{end}}{{end}}{{end}} data-bg="{{.Background}}" data-monitors="{{.Monitors}}"{{if .BgExecCount}} data-bg-exec="{{.BgExecCount}}" data-bg-exec-self="{{.BgExecSelf}}" data-bg-exec-desc="{{.BgExecDesc}}"{{end}}{{if .Lead.Done}} data-done="{{.Lead.Done}}"{{end}}{{if .Lead.Failed}} data-failed="{{.Lead.Failed}}"{{end}}{{if .Lead.TurnAddedTokens}} data-turn-tokens="{{.Lead.TurnAddedTokens}}"{{end}}{{if and (gt .ActivityAt 0) (ne .Conversation.Phase "") (ne .Conversation.Phase "idle")}} data-activity-at="{{.ActivityAt}}"{{end}}{{with .Conversation.Running}} data-tool="{{.ToolName}}"{{else}}{{with .Conversation.Generating}}{{with .ToolName}} data-tool="{{.}}"{{end}}{{end}}{{end}}>{{with .Conversation}}{{with .LiveTurnSummary}}{{template "turnsummary" .}}{{end}}{{with .Reply}}<div class="msg fromlead streaming"><div class="mh conv-row"><span class="row-icon"><span class="row-avatar">{{icon "robot"}}</span></span><span class="row-content"><b>{{t "tree.lead"}}</b></span><span class="row-time">{{template "clock" .StartedAt}}</span><span></span></div><div class="bub md">{{$.Conversation.ReplyHTML}}{{if .Truncated}} …{{end}}<span class="caret"></span></div></div>{{end}}{{if .Permission}}<div class="permwait{{if $.Hosted}} apslot{{end}}">{{icon "lock"}}<span><b>{{if $.Hosted}}{{t "convo.approval"}}{{else}}{{t "convo.perm"}}{{end}}</b> · <code title="{{.Permission.ToolName}}">{{toolName .Permission.ToolName}}</code> <span class="args">{{.Permission.ArgsPreview}}</span></span>{{template "dur" .Permission.StartedAt}}</div>{{else if eq .Phase "compacting"}}<details class="sysline boundary-badge compaction running" data-audit-owner="compaction"{{with $.Lead.PhaseStartedAt}} data-at-ms="{{.}}"{{end}}><summary><span class="mk"><span class="spin"></span></span>{{t "convo.activity" (phaseWord .Phase)}}</summary><div class="conv-audit-items"></div></details>{{else if and .Phase (ne .Phase "idle") (ne .Phase "replying")}}<div class="activity"><span class="spin"></span><span class="act-copy">{{t "convo.activity" (phaseWord .Phase)}}{{with .Running}} · {{toolName .ToolName}}{{else}}{{with .Generating}}{{with .ToolName}} · {{toolName .}}{{end}}{{end}}{{end}}{{if gt $.Lead.PhaseStartedAt 0}} · <time class="act-t" data-ms="{{$.Lead.PhaseStartedAt}}" data-f="since">{{sinceText $.ActivityAt $.Lead.PhaseStartedAt}}</time>{{if gt $.Lead.TurnStartedAt 0}} <span class="act-turn">({{t "convo.activity.turn"}} <time class="act-t" data-ms="{{$.Lead.TurnStartedAt}}" data-f="since">{{sinceText $.ActivityAt $.Lead.TurnStartedAt}}</time>)</span>{{end}}{{else if gt $.Lead.TurnStartedAt 0}} · <time class="act-t" data-ms="{{$.Lead.TurnStartedAt}}" data-f="since">{{sinceText $.ActivityAt $.Lead.TurnStartedAt}}</time>{{end}}</span></div>{{end}}{{with .Summary}}{{template "reasoningsummary" .}}{{end}}{{with $.Host}}{{with .Retry}}<details class="sysline boundary-badge retry running" data-audit-owner="retry" data-retry-attempt="{{.Attempt}}"{{with $.Lead.PhaseStartedAt}} data-at-ms="{{.}}"{{end}}><summary><span class="mk"><span class="spin"></span></span><span class="nt">{{if .MaxRetries}}{{t "convo.retry" .Attempt .MaxRetries}}{{else}}{{t "convo.retry.n" .Attempt}}{{end}}{{with .Error}}: {{.}}{{end}}</span></summary><div class="conv-audit-items"></div></details>{{end}}{{end}}{{range .Held}}{{template "held" .}}{{end}}<div class="sentdata" hidden>{{range .Sent}}<i data-id="{{.ID}}" data-answer="{{.Answer}}" data-note="{{.Note}}" data-state="{{if .Held}}held{{else}}sent{{end}}"></i>{{end}}</div>{{end}}</div>{{end}}

{{/* The status band (pageview_band.go): ctx is the context bar above the
message box, scaled to ws compaction thresholds when present; sline stays an
empty region while .fpills outside it owns the slim Model/Effort strip. */}}
{{define "r-ctx"}}{{with .Band.Context}}<div class="sb sb-top"><div class="sb-ctx{{with .Level}} {{.}}{{end}}" tabindex="0" role="meter" aria-label="{{if .Known}}{{t "band.ctx.title" .Percent .FullTokens}}{{else}}{{t "band.ctx.unknown" .FullTokens}}{{end}}" aria-valuemin="0" aria-valuemax="100"{{if .Known}} aria-valuenow="{{.Fill}}"{{end}}><span class="sb-pct">{{if .Known}}{{.Percent}}%{{else}}?{{end}}</span><div class="sb-bar-wrap">{{if .FloatIcon}}<span class="sb-float{{if .FloatAtHard}} at-hard{{end}}" style="{{if not .FloatAtHard}}left:{{.FloatLeft}}%;{{end}}--fc:{{.FloatColor}}" title="{{ctxBoundaryTitle .FloatIcon .FloatTitleArg}}"><svg class="li" aria-hidden="true"><use href="#l-{{.FloatIcon}}"/></svg></span>{{end}}<div class="sb-bar" aria-hidden="true"><i class="fill" style="width: {{.FillWidth}}%"></i>{{with .SoftPct}}<u class="m-soft" style="left: {{.}}%"></u>{{end}}{{range .MilestonePcts}}<u class="m-tick" style="left: {{.}}%"></u>{{end}}</div></div><span class="sb-tok">{{.Tokens}}{{with .Native}}<span class="sb-native"> ({{.}})</span>{{end}}</span>{{with .Cache}}<span class="sb-cache" title="{{t "band.cache.title"}}">{{t "band.cache" .}}</span>{{end}}</div><div class="ctx-tip" role="tooltip"><div class="ctx-tip-grid"><span>{{t "band.ctx.tip.current"}}</span><span>{{if .Known}}{{.TipCurrent}}{{else}}{{t "band.ctx.tip.unknown"}}{{end}}</span>{{with .TipSoft}}<span>{{t "band.ctx.tip.soft"}}</span><span>{{.}}</span>{{end}}{{with .TipM1}}<span>{{t "band.ctx.tip.m1"}}</span><span>{{.}}</span>{{end}}{{with .TipM2}}<span>{{t "band.ctx.tip.m2"}}</span><span>{{.}}</span>{{end}}{{with .TipHard}}<span>{{t "band.ctx.tip.hard"}}</span><span>{{.}}</span>{{end}}{{with .TipNative}}<span>{{t "band.ctx.tip.native"}}</span><span>{{.}}</span>{{end}}{{with .Cache}}<span>{{t "band.cache.title"}}</span><span>{{.}}</span>{{end}}</div></div></div>{{end}}{{end}}

{{/* composerpills: slim 2-control strip (Model + Effort only, decision (38))
rendered outside SSE-swapped r-sline so popovers and focus survive swaps. */}}
{{define "composerpills"}}<div class="fpills" id="composer-pills"><div class="fpill-wrap"><button type="button" class="fpill" data-pop="model" aria-haspopup="listbox" aria-expanded="false"{{if not .CanEditSettings}} disabled{{end}} title="{{if .IsChild}}{{t "js.lead.controls.child"}}{{else if not .CanEditSettings}}{{t "js.lead.controls.host"}}{{else}}{{t "js.lead.controls.model"}}{{end}}"><svg class="i li ico" aria-hidden="true"><use href="#l-cpu"/></svg><span class="pv">{{or .Model (t "js.sup.default")}}</span>{{if .IsChild}}<svg class="i li lock" aria-hidden="true"><use href="#l-lock"/></svg>{{else}}<svg class="i li chev" aria-hidden="true"><use href="#l-chevron-down"/></svg>{{end}}</button></div><div class="fpill-wrap"><button type="button" class="fpill" data-pop="effort" aria-haspopup="listbox" aria-expanded="false"{{if not .CanEditSettings}} disabled{{end}} title="{{if .IsChild}}{{t "js.lead.controls.child"}}{{else if not .CanEditSettings}}{{t "js.lead.controls.host"}}{{else}}{{t "js.lead.controls.effort"}}{{end}}"><svg class="i li ico" aria-hidden="true"><use href="#l-gauge"/></svg><span class="pv">{{or .Effort (t "js.sup.default")}}</span>{{if .IsChild}}<svg class="i li lock" aria-hidden="true"><use href="#l-lock"/></svg>{{else}}<svg class="i li chev" aria-hidden="true"><use href="#l-chevron-down"/></svg>{{end}}</button></div></div>{{end}}

{{/* cmds: the slash commands the session's adapter runs, hidden data the
composer's command picker reads (dashboard.js commandList); empty when the
adapter reports none, and then the page offers no picker. The session page
carries it for a browser on this machine only (SysOpen), since the daemon
holds a dashboard command from no other viewer (sendCommand). */}}
{{define "r-cmds"}}{{range .Commands}}<i data-name="{{.Name}}"{{with .Description}} data-desc="{{.}}"{{end}}{{with .Source}} data-src="{{.}}"{{end}}{{with .Layer}} data-layer="{{.}}"{{end}}></i>{{end}}{{end}}

{{define "r-sline"}}{{end}}

{{/* The git region (gitbadge.go): the Git page's live data carrier, no
markup that shows. Its attributes carry the session root's standing (state:
ok, pending, failed, or norepo for a root that is no repository), the branch
and its abbreviation (GitHandle: impl, goal, the stem), the upstream with the
ahead and behind counts, and the staged, modified and untracked counts; the
page script patches the strip from them by key and reads the changed files
again when they move. at carries the read's time, so every read swaps the region. */}}
{{define "r-git"}}{{with .Git}}<span class="gp-data" id="gitdata" hidden data-state="{{.State}}" data-at="{{.At}}"{{if eq .State "ok"}} data-branch="{{.Branch}}"{{if .Detached}} data-detached=""{{end}}{{with .Handle}} data-short="{{.Text}}"{{if .Goal}} data-goal=""{{end}}{{if .Impl}} data-impl=""{{end}}{{end}} data-upstream="{{.Upstream}}" data-ahead="{{.Ahead}}" data-behind="{{.Behind}}" data-staged="{{.Staged}}" data-modified="{{.Modified}}" data-untracked="{{.Untracked}}"{{with .Ticket}} data-ticket="{{.}}"{{end}}{{else if eq .State "failed"}} data-err="{{.Err}}"{{end}}></span>{{end}}{{end}}

{{/* held: a message the session has not received yet. A slash command's
bubble shows its typed line; its steer control sends that line as steered
text the agent acts on itself (wsinbox.Steer). */}}
{{define "held"}}{{if .ExecNotice}}<div class="exec-notice held-exec{{if .ExecNotice.Failed}} fail{{end}}" data-entry="{{.ID}}" data-exec-id="{{.ExecNotice.ID}}"><div class="conv-row"><span class="row-icon"><svg class="i li" aria-hidden="true"><use href="#l-square-terminal"/></svg></span><span class="row-content"><span class="exec-cmd" title="{{or .ExecNotice.Command .ExecNotice.ID}}">{{.ExecNotice.Summary}}</span><span class="exec-meta">{{.ExecNotice.StatusLabel .Lang}}{{with .ExecNotice.Duration}} · {{.}}{{end}} · {{if .Steer}}{{t "held.steer"}}{{else}}{{t "held.held"}}{{end}}</span></span><span class="row-time">{{template "clock" .At}}</span></div></div>{{else}}<div class="msg user held{{if .Command}} hcmd{{end}}" data-entry="{{.ID}}"><div class="mh"><span class="src wb">{{t "origin.whiteboard"}}</span>{{if .Steer}}<span class="heldtag steertag" title="{{t "held.steer.title"}}">{{t "held.steer"}}</span>{{else}}<span class="heldtag" title="{{t "held.held.title"}}">{{t "held.held"}}</span>{{end}}{{template "clock" .At}}{{if not .Steer}}{{template "hsteer" .ID}}{{end}}{{template "hcancel" .ID}}</div><div class="bub">{{with .Command}}<code class="cmdtyped">/{{.Name}}{{with .Args}} {{.}}{{end}}</code>{{else}}{{$u := .Hydrated}}{{template "chipset" $u}}{{if $u.Grouped}}{{$u.Body}}{{else}}{{range $i, $p := $u.Parts}}{{if $i}}<hr class="pdiv">{{end}}<div class="hpart">{{$p}}</div>{{end}}{{end}}{{template "bubblethumbs" .}}{{end}}</div></div>{{end}}{{end}}
{{/* hsteer and hcancel: a held bubble's buttons, for its ID. The composer's
heldacts template holds an empty-ID pair the client clones for the outbox: both
onto the bubble it builds for a send the daemon just held (outboxBubble),
before the server renders this one, and the cancel onto a send's row while
its post is unanswered (outboxRow). */}}
{{define "hsteer"}}<button class="btn mini hsteer" data-steer="{{.}}" title="{{t "held.steerbtn.title"}}">{{icon "arrow"}}{{t "held.steer"}}</button>{{end}}
{{define "hcancel"}}<button class="btn mini hcancel" data-cancel="{{.}}" title="{{t "held.cancel.title"}}">{{icon "x"}}{{t "held.cancel"}}</button>{{end}}
{{/* achips / chipset: a user message's answer capsules, above its text, styled as the
composer's chips: "(ids) value" with the note beside it, a topic note as
"[topic]" and its note. A held bubble lists one per chip, a delivered one
one per line of the answer block its text started with. The message's
mentions follow as "[topic] (id)" and an excerpt of the selected text, then
a picked page element as its selector and text, and attached console errors
as "console xN" and the page's URL. Unanchored header items remain here;
items hydrated inline in prose are deduplicated. */}}
{{define "chipset"}}{{if or .AnswerChips .MentionChips .CloseRequests .Picks .Consoles}}<div class="hchips">{{range .AnswerChips}}{{if .Topic}}<span class="achip tchip" title="{{.Note}}" role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}"><b>[{{.Topic}}]</b><span class="anote">{{.Note}}</span></span>{{else}}<span class="achip"{{with .Note}} title="{{.}}"{{end}}{{if .Target}} role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}"{{end}}><b>({{.IDs}})</b> {{or .Value "note"}}{{with .Note}}<span class="anote">{{.}}</span>{{end}}</span>{{end}}{{end}}{{range .MentionChips}}<span class="achip mchip" title="{{.Text}}" role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}"><b>[{{.Topic}}]{{with .IDs}} ({{.}}){{end}}</b><span class="anote">{{.Text}}</span></span>{{end}}{{range .CloseRequests}}<span class="achip close-request-chip"><b>{{t "js.closerequest.label" .Topic}}</b>{{with .Reason}}<span class="anote" title="{{.}}">{{.}}</span>{{end}}</span>{{end}}{{range .Picks}}<span class="achip mchip pchip" title="{{.URL}}&#10;{{.Selector}}{{with .Text}}&#10;{{.}}{{end}}"><b>{{.Selector}}</b>{{with .Text}}<span class="anote">{{.}}</span>{{end}}</span>{{end}}{{range .Consoles}}<span class="achip mchip cchip" title="{{.URL}}{{range .Lines}}&#10;{{.}}{{end}}"><b>console &times;{{len .Lines}}</b><span class="anote">{{.URL}}</span></span>{{end}}</div>{{end}}{{end}}
{{define "achips"}}{{if or .Answers .Mentions .CloseRequests .Picks .Consoles}}{{template "chipset" .}}{{end}}{{end}}

{{/* Selection source and memo stay plain escaped text; only the parser's
image-reference tail owns thumbnails. A failed group remains wholly literal. */}}
{{define "selection-content"}}{{range .}}{{with .Selection}}{{renderSelection .}}{{else}}{{if .Plain}}{{.Text}}{{else}}{{marked .Text}}{{end}}{{end}}{{end}}{{end}}

{{define "thumbs"}}<div class="thumbs">{{range .}}{{if .Src}}<a class="thumb" href="{{.Src}}" target="_blank" rel="noopener noreferrer" title="{{.Path}}"><img src="{{.Src}}" alt="{{.Name}}" loading="lazy">{{with .Num}}<span class="tnum">#{{.}}</span>{{end}}</a>{{else if .Path}}<span class="ipath">{{if .Num}}Image #{{.Num}}: {{.Path}}{{else}}[image: {{.Path}}]{{end}}</span>{{else}}<span class="ipath">[Image #{{.Num}}]</span>{{end}}{{end}}</div>{{end}}

{{define "textrefthumb"}}<span class="textref-thumb" data-textref="{{.Num}}" data-icapsule="1" data-icapsule-click="1" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" title="{{t "textref.title" .Num .SizeText .Lines}}"><span class="textref-ico"><svg class="li" aria-hidden="true"><use href="#l-file-text"/></svg></span><span class="tnum">#{{.Num}}</span><template class="icapsule-source"><div class="icapsule-pop-hd"><b class="icapsule-pop-title">{{t "textref.pop.title" .Num}}</b><span class="icapsule-pop-meta-dim">{{t "textref.pop.meta" .SizeText .Lines}}</span></div><pre class="icapsule-pop-textref">{{.Body}}</pre></template></span>{{end}}

{{define "bubblethumbs"}}{{if or .AllImages .TextRefs}}<div class="thumbs">{{range .AllImages}}{{if .Src}}<a class="thumb" href="{{.Src}}" target="_blank" rel="noopener noreferrer" title="{{.Path}}"><img src="{{.Src}}" alt="{{.Name}}" loading="lazy">{{with .Num}}<span class="tnum">#{{.}}</span>{{end}}</a>{{else if .Path}}<span class="ipath">{{if .Num}}Image #{{.Num}}: {{.Path}}{{else}}[image: {{.Path}}]{{end}}</span>{{else}}<span class="ipath">[Image #{{.Num}}]</span>{{end}}{{end}}{{range .TextRefs}}{{template "textrefthumb" .}}{{end}}</div>{{end}}{{end}}

{{define "origin"}}{{if eq . "whiteboard"}}<span class="src wb">{{t "origin.whiteboard"}}</span>{{else if eq . "mail"}}<span class="src mail">{{t "origin.mail"}}</span>{{else if eq . "terminal"}}<span class="src">{{t "origin.terminal"}}</span>{{end}}{{end}}

{{/* msgacts: a finished chat block's hover actions, a sibling of its bubble
(a finished reply's bubble clips paint). Copy reads the block's stored text
from the entry text route (entry_text_route.go) on click; an owner prompt
also gets rewind and edit, placeholders the harness cannot serve yet:
aria-disabled, not disabled, so they stay focusable and their tooltip
reachable. A streaming reply and a held message have none. */}}
{{define "msgacts"}}<div class="d-acts" role="toolbar" aria-label="{{t "entry.act.label"}}">{{if eq .Kind "user"}}<button type="button" class="d-act" data-act="rewind" aria-disabled="true" aria-label="{{t "entry.act.rewind"}}" data-tip="{{t "entry.act.rewind"}}">{{icon "undo"}}</button><button type="button" class="d-act" data-act="edit" aria-disabled="true" aria-label="{{t "entry.act.edit"}}" data-tip="{{t "entry.act.edit"}}">{{icon "pencil"}}</button>{{end}}<button type="button" class="d-act" data-act="copy" aria-label="{{if .Truncated}}{{t "entry.act.copy.part"}}{{else}}{{t "entry.act.copy"}}{{end}}" data-tip="{{if .Truncated}}{{t "entry.act.copy.part"}}{{else}}{{t "entry.act.copy"}}{{end}}"><span class="d-act-cp">{{icon "copy"}}</span><span class="d-act-ok">{{icon "check"}}</span><span class="d-act-done">{{if .Truncated}}{{t "entry.act.copied.part"}}{{else}}{{t "entry.act.copied"}}{{end}}</span></button></div>{{end}}

{{define "execnotice"}}<details class="exec-notice turn-trigger{{if .ExecNotice.Failed}} fail{{end}}" data-wake-cause="background_exit" data-exec-id="{{.ExecNotice.ID}}"{{if .Key}} data-entry="{{.Key}}" data-key="exec-{{.Key}}"{{else}} data-key="exec-{{.ExecNotice.ID}}"{{end}}{{with .AtRFC}} data-at="{{.}}"{{end}}><summary class="conv-row"><span class="row-icon"><svg class="i li" aria-hidden="true"><use href="#l-square-terminal"/></svg></span><span class="row-content"><span class="exec-cmd" title="{{or .ExecNotice.Command .ExecNotice.ID}}">{{.ExecNotice.Summary}}</span><span class="exec-meta">{{.ExecNotice.StatusLabel .Lang}}{{with .ExecNotice.Duration}} · {{.}}{{end}}</span></span><span class="row-time">{{if .EnvelopeAt}}<time class="t" data-ms="{{.At}}" data-f="user" datetime="{{.EnvelopeAt}}" title="{{.EnvelopeAt}}">{{.EnvelopeAt}}</time>{{else}}{{template "clock" .At}}{{end}}</span><span class="row-chevron">{{icon "chev"}}</span></summary><div class="row-details">{{with .ExecNotice.Command}}<div class="exec-details-cmd"><code>{{.}}</code></div>{{end}}<div class="exec-details-meta"><span class="exec-details-st">{{.ExecNotice.StatusLabel .Lang}}</span>{{with .ExecNotice.Duration}}<span> · {{.}}</span>{{end}}{{with .ExecNotice.ErrorText}}<span> · {{.}}</span>{{end}}{{with .ExecNotice.StopInfo}}<div class="exec-details-stop">{{.}}</div>{{end}}</div>{{if .ExecNotice.NoOutput}}<div class="exec-details-empty">{{.ExecNotice.OutputLabel .Lang}}</div>{{else}}<div class="exec-details-out-head">{{.ExecNotice.OutputLabel .Lang}}</div><pre class="wake-body">{{.ExecNotice.Output}}{{if .Truncated}} …{{end}}</pre>{{end}}{{with .ExecNotice.ID}}<div class="exec-details-foot"><button type="button" class="exec-view-out" data-bg-exec-jump="{{.}}">{{t "entry.exec.view_output"}}</button><span class="exec-row-expired" hidden>{{t "entry.exec.expired"}}</span></div>{{end}}</div></details>{{end}}

{{define "userentry"}}<div class="msg user"{{with .Key}} data-entry="{{.}}"{{end}}{{with .AtRFC}} data-at="{{.}}"{{end}}><div class="mh">{{template "origin" .Origin}}{{if .EnvelopeAt}}<time class="t" data-ms="{{.At}}" data-f="user" datetime="{{.EnvelopeAt}}" title="{{.EnvelopeAt}}">{{.EnvelopeAt}}</time>{{else}}{{template "clock" .At}}{{end}}</div><div class="bub">{{$u := .Hydrated}}{{template "chipset" $u}}{{$u.Body}}{{if .Truncated}} …{{end}}{{template "bubblethumbs" .}}</div>{{template "msgacts" .}}</div>{{end}}

{{define "entry"}}{{if .MailWakeSuppressed}}<span hidden data-entry="{{.Key}}" data-mail-wake="suppressed"{{with .AtRFC}} data-at="{{.}}"{{end}}></span>{{else if .TurnAbsorbed}}<span hidden data-entry="{{.Key}}" data-turn-absorbed="1"{{with .AtRFC}} data-at="{{.}}"{{end}}></span>{{else if .TurnLiveAbsorbed}}<span hidden data-entry="{{.Key}}" data-turn-live-absorbed="1"{{with .AtRFC}} data-at="{{.}}"{{end}}></span>{{else if .TurnSummary}}{{template "turnsummary" .TurnSummary}}{{else if .TurnReasoningOnly}}{{$summary := .Summary}}{{if $summary}}<div class="turn-with-summary" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}>{{template "reasoningsummary" $summary}}</div>{{else}}<span hidden data-entry="{{.Key}}" data-turn-absorbed="1"{{with .AtRFC}} data-at="{{.}}"{{end}}></span>{{end}}{{else if eq .Kind "user"}}{{if .UserBlocks}}<div class="user-batch" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}>{{range .UserBlocks}}{{if .ExecNotice}}{{template "execnotice" .}}{{else}}{{template "userentry" .}}{{end}}{{end}}</div>{{else if .ExecNotice}}{{template "execnotice" .}}{{else}}{{template "userentry" .}}{{end}}{{else if eq .Kind "reply"}}<div class="msg fromlead" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}><div class="mh conv-row"><span class="row-icon"><span class="row-avatar">{{icon "robot"}}</span></span><span class="row-content"><b>{{t "tree.lead"}}</b></span><span class="row-time">{{template "clock" .At}}</span><span></span></div><div class="bub md">{{.HTML}}{{if .Truncated}} …{{end}}</div>{{template "msgacts" .}}</div>{{else if eq .Kind "whiteboard-effects"}}{{template "whiteboardentry" .}}{{else if eq .Kind "wake"}}{{template "wakeentry" .}}{{else if eq .Kind "turn"}}{{$summary := .Summary}}{{$plain := .TurnPlain}}{{if or $summary $plain}}<div class="{{if $summary}}turn-with-summary{{else}}turn-plain-host{{end}}" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}>{{if $summary}}{{template "reasoningsummary" $summary}}{{end}}{{end}}<details class="turnline{{if .WakeTurn}} wake-turn{{end}}"{{if not (or $summary $plain)}} data-entry="{{.Key}}" data-key="turn-{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}{{end}}><summary class="conv-row"><span class="row-icon">{{icon "clock"}}</span><span class="row-content">{{if .WakeTurn}}↳ {{t "entry.leadturn" .Done}}{{else}}{{template "origin" .Origin}}{{t "entry.turn" .Done}}{{end}}{{with .Failed}} · {{t "count.failed" .}}{{end}}<span class="turn-audit-counts"></span>{{with .DurationMs}}<span> · {{template "span" .}}</span>{{end}}</span><span class="row-time">{{template "clock" .At}}</span><span class="row-chevron">{{icon "chev"}}</span></summary><div class="conv-audit-items"></div></details>{{with $plain}}{{template "turnsummary" .}}{{end}}{{if or $summary $plain}}</div>{{end}}{{else if eq .Kind "tools"}}{{with .Tools}}{{if toolsHasCallIDs .}}{{template "audittools" (auditTools $.Key $.At $.AtRFC .)}}{{else}}<details class="toolsline" data-entry="{{$.Key}}" data-key="tools-{{$.Key}}"{{with $.AtRFC}} data-at="{{.}}"{{end}}><summary class="conv-row">{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{end}}{{else if eq .Kind "compact"}}<details data-audit-owner="compaction" class="sysline boundary-badge compaction{{if .CompactFailed}} fail{{end}}" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}><summary>{{if .CompactFailed}}<span class="mk">✗</span><span class="nt">{{t "entry.compact.failed"}}{{with .Text}}: {{.}}{{end}}</span>{{else}}<span class="mk">✓</span>{{t "entry.compact.done"}}{{if eq .Trigger "auto"}} {{t "entry.compact.auto"}}{{else if eq .Trigger "manual"}} {{t "entry.compact.manual"}}{{end}}{{end}}{{template "clock" .At}}</summary><div class="conv-audit-items"></div></details>{{else if eq .Kind "mail"}}{{if or .PeerLead .MatchedMailWake}}{{template "peermailentry" .}}{{else if .HasBody}}<details class="mailline turn-trigger {{.Direction}}" data-entry="{{.Key}}" data-key="mail-{{.Key}}"{{if .SystemMail}} data-mail-system="1" data-mail-ts="{{.At}}"{{end}}{{with .AtRFC}} data-at="{{.}}"{{end}}><summary class="conv-row">{{template "mailhead" .}}</summary><div class="mbody">{{.Body}}</div></details>{{else}}<div class="mailline turn-trigger {{.Direction}} nobody" data-entry="{{.Key}}"{{if .SystemMail}} data-mail-system="1" data-mail-ts="{{.At}}"{{end}}{{with .AtRFC}} data-at="{{.}}"{{end}}><div class="conv-row">{{template "mailhead" .}}</div></div>{{end}}{{else if eq .Kind "card"}}{{with .Card}}<div class="cardref" data-entry="{{$.Key}}" data-tk-store="{{.Store}}" data-tk-alias="{{.Alias}}" title="{{t "entry.card.title" .Store}}"{{with $.AtRFC}} data-at="{{.}}"{{end}}><span class="crk">{{t "entry.card"}}</span><b class="cra">{{.Alias}}</b>{{with .Title}}<span class="crt">{{.}}</span>{{end}}</div>{{end}}{{else if eq .Kind "notice"}}{{with .Notice}}<details class="sysline boundary-badge notice fail" data-entry="{{$.Key}}" data-notice="{{.Kind}}"{{with $.AtRFC}} data-at="{{.}}"{{end}}><summary><span class="mk">✗</span><span class="nt"><b>{{template "noticeword" .Kind}}</b>{{if and (eq .Kind "usage_limit") (gt .ResetsAt 0)}} · {{t "notice.resets"}} <time class="t" data-ms="{{.ResetsAt}}" data-f="dt">{{clock .ResetsAt}}</time>{{end}}{{with .Text}}: {{.}}{{end}}</span>{{template "clock" $.At}}</summary><div class="conv-audit-items"></div></details>{{end}}{{else if eq .Kind "command"}}<div class="cmdrun" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}><div class="cmdecho"><span class="mk">❯</span><code>{{.Command}}</code>{{template "clock" .At}}</div>{{if .Text}}<pre class="cmdout">{{.Text}}{{if .Truncated}} …{{end}}</pre>{{else}}<div class="cmdnote">{{t "entry.command.terminal"}}</div>{{end}}</div>{{else if eq .Kind "ui"}}{{with .UI}}<div class="sysline uiline conv-row" data-entry="{{$.Key}}" data-ui-op="{{.Op}}" data-ui-arg="{{.Arg}}"{{with .Comment}} data-ui-comment="{{.}}"{{end}} title="{{t "entry.ui"}}"{{with $.AtRFC}} data-at="{{.}}"{{end}}><span class="row-icon mk">↗</span><span class="row-content">{{if eq .Op "search"}}{{t "entry.ui.search" .Arg}}{{else if eq .Op "focus"}}{{with .Comment}}{{t "entry.ui.focus.comment" $.UI.Arg .}}{{else}}{{t "entry.ui.focus" .Arg}}{{end}}{{else if eq .Op "scope"}}{{t "entry.ui.scope" .Arg}}{{else}}{{t "entry.ui.view" .Arg}}{{end}}</span><span class="row-time">{{template "clock" $.At}}</span><span></span></div>{{end}}{{end}}{{end}}

{{/* Summary text is escaped plain text, never marked or reply markdown. */}}
{{define "reasoningsummary"}}<details class="d-summary {{if .Live}}live{{else}}saved{{end}}" data-key="{{.Key}}"{{if .Live}} open{{end}}><summary>{{icon "chev"}}<span class="d-label">{{t "summary.label"}}</span><span class="d-meta">{{t "summary.provider"}}</span>{{if .Streaming}}<span class="d-updating">{{t "summary.updating"}}</span>{{else if not .Live}}<span class="d-meta d-open">{{t "summary.expand"}}</span><span class="d-meta d-close">{{t "summary.collapse"}}</span>{{end}}</summary><div class="d-body">{{range .Requests}}<div class="d-attempt"><div class="d-meta">{{t "summary.attempt" .Request .Attempt}} · {{.Provider}} / {{.API}} / {{.Model}} · {{template "summarystatus" .Status}}{{if .Truncated}} · {{t "summary.clipped"}}{{end}}</div>{{range .Parts}}{{if .Text}}<div class="d-part"><span class="d-meta">{{t "summary.part" .Output .Part}} · {{template "summarystatus" .Status}}{{if .Truncated}} · {{t "summary.bytes" .RetainedBytes .ObservedBytes}}{{end}}</span><p>{{.Text}}</p></div>{{end}}{{end}}</div>{{end}}{{if .Truncated}}<span class="d-provenance">{{t "summary.clipped"}}</span>{{end}}<span class="d-provenance">{{if .Live}}{{t "summary.observed"}}{{else}}{{t "summary.retained"}}{{end}}</span></div></details>{{end}}
{{define "summarystatus"}}{{if eq . "streaming"}}{{t "summary.streaming"}}{{else if eq . "complete"}}{{t "summary.complete"}}{{else if eq . "aborted"}}{{t "summary.aborted"}}{{else if eq . "failed"}}{{t "summary.failed"}}{{else if eq . "incomplete"}}{{t "summary.incomplete"}}{{end}}{{end}}

{{/* Panels render a recap row plus a bounded, sanitized content preview. Logs
render inline-only markdown with board references. Unsupported fallback is
escaped text: no raw HTML, iframe, or client-side HTML interpretation here. */}}
{{define "whiteboardentry"}}{{$card := .WhiteboardCard}}<article class="wbeffects wbupdate" data-entry="{{.Key}}"{{with .AtRFC}} data-at="{{.}}"{{end}}><div class="wbupdate-head"><b>{{t "entry.whiteboard"}}</b>{{template "clock" .At}}</div>{{template "whiteboardtopics" $card}}{{template "whiteboarddiagnostics" .}}</article>{{end}}

{{define "whiteboardtopics"}}{{range .Topics}}<section class="wbupdate-topic"{{with .Target}} data-wb-topic="{{.}}"{{end}}><div class="wbupdate-bar"><b>{{or .Label .Name (t "entry.whiteboard")}}</b>{{if and .Label (ne .Label .Name)}}<span class="wbupdate-key">{{.Name}}</span>{{end}}{{if .Target}}<a href="#{{.Target}}" data-wb-jump="{{.Target}}" data-wb-topic="{{.Target}}">{{t "entry.whiteboard.topic"}} ↗</a>{{end}}</div><div class="wbupdate-rows">{{$topic := .Target}}{{range .RowGroups}}{{if .IsLog}}<div class="wbupdate-log-well">{{end}}{{range .Rows}}{{if and (eq .Kind "panel") .PreviewHTML}}<div class="wbupdate-panel-wrap"{{if and .Target $topic}} data-wb-element="{{.Target}}"{{end}}>{{end}}<div class="wbupdate-row wbupdate-{{.Kind}}{{if and (eq .Kind "panel") .PreviewHTML}} wbupdate-panel-has-preview{{end}}"{{if and .Target $topic}} data-wb-element="{{.Target}}"{{if eq .Kind "log"}} tabindex="0" role="link"{{end}}{{end}}>{{if eq .Kind "log"}}<span class="wbupdate-l" aria-hidden="true">L</span>{{else if eq .Kind "panel"}}<span class="wbupdate-panel-label">{{icon "board"}}{{t "entry.whiteboard.panel"}}</span>{{end}}<span class="wbupdate-text">{{if eq .Kind "log"}}{{.TextHTML}}{{else if .Text}}{{range .Parts}}{{if .Target}}<span class="wbref" role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}{{else if eq .Kind "panel"}}{{t "entry.whiteboard.norecap"}}{{end}}</span>{{if and (eq .Kind "panel") .Target $topic}}<a href="#{{.Target}}" data-wb-jump="{{.Target}}" data-wb-topic="{{$topic}}">#{{.Target}}</a>{{end}}</div>{{if and (eq .Kind "panel") .PreviewHTML}}<div class="wbupdate-panel-body md">{{.PreviewHTML}}</div></div>{{end}}{{end}}{{if .IsLog}}</div>{{end}}{{end}}{{with .Items}}<div class="wbupdate-items">{{range .}}{{if and .Target $topic}}<a class="wbupdate-item-id" href="#{{.Target}}" data-wb-jump="{{.Target}}" data-wb-topic="{{$topic}}">({{.ID}})</a>{{else}}<span class="wbupdate-item-id">({{.ID}})</span>{{end}}{{end}}</div>{{end}}</div><span class="wbupdate-status" role="status" aria-live="polite"></span></section>{{end}}{{end}}

{{define "whiteboarddiagnostics"}}{{if not .WhiteboardChanges}}<p class="wbeffect-note">{{t "entry.whiteboard.unavailable"}}</p><pre class="wbeffect-fallback">{{.WhiteboardFallback}}</pre>{{end}}{{if .Truncated}}<p class="wbeffect-note">{{t "entry.whiteboard.truncated"}}</p>{{end}}{{end}}

